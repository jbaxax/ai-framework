#!/usr/bin/env bash
set -euo pipefail

FW_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
OPENCODE_HOME="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
GEMINI_HOME="${GEMINI_CONFIG_DIR:-$HOME/.gemini}"
GEMINI_CLI_HOME="${ANTIGRAVITY_CONFIG_DIR:-$GEMINI_HOME/antigravity-cli}"
GIT_IGNORE_GLOBAL="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
# Rules that belong to one project. fw reads this file and never writes it,
# which is what makes a reinstall unable to destroy it.
PROJECT_RULES="PROJECT-RULES.md"

# Git Bash's `ln -s` copies instead of symlinking on Windows unless this is
# set, even with Developer Mode on, because MSYS only calls the native
# CreateSymbolicLink API in this mode. Set it here so `fw link` works from any
# shell profile that invokes this script, not just ones that export it.
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*) export MSYS="${MSYS:-winsymlinks:nativestrict}" ;;
esac

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'

ok()   { printf '  %s✓%s %s\n' "$GREEN" "$OFF" "$1"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$OFF" "$1"; }
FW_BAD=0
bad()  { FW_BAD=$((FW_BAD+1)); printf '  %s✗%s %s\n' "$RED" "$OFF" "$1"; }
note() { printf '    %s%s%s\n' "$DIM" "$1" "$OFF"; }
head1(){ printf '\n%s\n' "$1"; }

link_or_warn() {
  local src="$1" dst="$2" label="$3"
  ln -sfn "$src" "$dst"
  if [ -L "$dst" ]; then
    ok "$label -> $src"
  else
    bad "$label -> $src (ln did not create a real symlink, got a copy instead)"
    note "Windows needs Developer Mode on AND MSYS=winsymlinks:nativestrict for ln -s to work"
  fi
}

# `command -v` is not enough on Windows: App Execution Aliases put a python3
# stub on PATH that prints "install from the Microsoft Store" and exits 49. It
# resolves, so the old lookup returned it and every hook registration failed
# with doctor telling you to run the command that had just failed. A candidate
# only counts if it actually runs Python.
python_bin() {
  local c p
  for c in python3 python py; do
    p="$(command -v "$c" 2>/dev/null)" || continue
    [ -n "$p" ] || continue
    "$p" -c '' >/dev/null 2>&1 || continue
    printf '%s' "$p"; return
  done
}

is_windows() {
  case "$(uname -s 2>/dev/null)" in MINGW*|MSYS*|CYGWIN*) return 0 ;; *) return 1 ;; esac
}

# The string settings.json will hold. Claude Code launches a hook through the
# host shell, so on Windows it must be a .cmd at a path cmd.exe can resolve — an
# MSYS /c/Users path, or a bare .sh, is silently unrunnable there. It points at
# the repository and not a symlink under $HOME because on Windows `ln -s`
# degrades to a copy, and a copied guard goes stale the moment a rule changes.
hook_script() {
  if is_windows; then printf '%s' "$FW_ROOT/hooks/$1.cmd"
  else printf '%s' "$FW_ROOT/hooks/$1.sh"; fi
}

hook_command() {
  local path; path="$(hook_script "$1")"
  if is_windows; then cygpath -m "$path" 2>/dev/null || printf '%s' "$path"
  else printf '%s' "$path"; fi
}

plan_hook_command() { hook_command plan-guard; }
plan_hook_script()  { hook_script  plan-guard; }

# register_hook <mode> <label> <event> <basename>
register_hook() {
  local mode="$1" label="$2" event="$3" base="$4"
  local settings="$CLAUDE_HOME/settings.json"
  local hook; hook="$(hook_command "$base")"
  local py; py="$(python_bin)"

  if [ -z "$py" ]; then
    bad "$label hook: no python on PATH, cannot read or write $settings"
    note "register it by hand under .hooks.$event:"
    note "  { \"hooks\": [ { \"type\": \"command\", \"command\": \"$hook\" } ] }"
    return
  fi

  if [ "$mode" = check ]; then
    if "$py" "$FW_ROOT/hooks/register-hook.py" "$settings" "$hook" --check --event "$event" >/dev/null 2>&1; then
      ok "$label hook registered in settings.json"
    else
      bad "$label hook NOT registered in settings.json — run 'fw link'"
    fi
    return
  fi

  local result rc=0
  result="$("$py" "$FW_ROOT/hooks/register-hook.py" "$settings" "$hook" --event "$event" 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    bad "$label hook: could not register — $result"
    return
  fi
  ok "$label hook $result in settings.json"
  if [ "$result" = added ]; then
    note "settings.json changed — refresh the snapshot so doctor stays quiet:"
    note "  cp \"$settings\" \"$FW_ROOT/machine/claude-settings.json\""
  fi
}

register_plan_hook() { register_hook "${1:-install}" plan UserPromptSubmit plan-guard; }
register_pass_hook() { register_hook "${1:-install}" pass Stop            pass-guard; }

has_dep() {
  [ -f package.json ] || return 1
  grep -qE "\"$1\"[[:space:]]*:" package.json
}

detect_stacks() {
  local found=()
  has_dep '@angular/core' && found+=(angular)
  has_dep 'next'          && found+=(react-next)
  if ! has_dep 'next' && has_dep 'react'; then found+=(react); fi
  has_dep '@nestjs/core'  && found+=(nest)
  has_dep 'astro'         && found+=(astro)
  printf '%s\n' "${found[@]:-}"
}

detect_sharing() {
  git rev-parse --git-dir >/dev/null 2>&1 || { echo personal; return; }

  local authors
  authors=$(git log --format='%ae' 2>/dev/null | sort -u | wc -l | tr -d ' ')
  [ "$authors" -gt 1 ] && { echo shared; return; }

  # One author is not proof the repository is yours. A company repo you are the
  # only committer on still belongs to the company. Compare the identity that
  # wrote the history against the one git is configured with: a mismatch means
  # this history was written as somebody else — a work account — and personal
  # files must not be committed into it.
  local hist_author cfg_author
  hist_author=$(git log -1 --format='%ae' 2>/dev/null)
  cfg_author=$(git config user.email 2>/dev/null)
  if [ -n "$hist_author" ] && [ -n "$cfg_author" ] && [ "$hist_author" != "$cfg_author" ]; then
    echo shared; return
  fi

  echo personal
}

link_skills_into() {
  local home="$1" label="$2"
  mkdir -p "$home/skills"
  for skill in "$FW_ROOT"/skills/*/; do
    [ -d "$skill" ] || continue
    local name; name="$(basename "$skill")"
    local target="$home/skills/$name"
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      bad "$label: skill $name exists and is NOT a symlink — left untouched"
      note "resolve by hand: $target"
      continue
    fi
    link_or_warn "${skill%/}" "$target" "$label: skill $name"
  done
}

cmd_link() {
  head1 "Linking framework into $CLAUDE_HOME (once per machine)"
  mkdir -p "$CLAUDE_HOME/rules"

  for rule in "$FW_ROOT"/rules/*.md; do
    [ -e "$rule" ] || continue
    local name="fw-$(basename "$rule")"
    link_or_warn "$rule" "$CLAUDE_HOME/rules/$name" "rule  $name"
  done

  head1 "Prompt hook (global, once per machine)"
  note "recognises \"elabora un plan para ...\" and names the flow before any step"
  note "and names the installed skills whose triggers the prompt matches"
  local hook_script; hook_script="$(plan_hook_script)"
  if [ -f "$hook_script" ]; then
    ok "hook  $(basename "$hook_script")"
  else
    bad "hook  $(basename "$hook_script") missing from $FW_ROOT/hooks"
  fi
  register_plan_hook install

  head1 "Stop hook (global, once per machine)"
  note "names what changed that no check can see, so the manual pass stops"
  note "depending on anyone remembering it"
  local pass_script; pass_script="$(hook_script pass-guard)"
  if [ -f "$pass_script" ]; then
    ok "hook  $(basename "$pass_script")"
  else
    bad "hook  $(basename "$pass_script") missing from $FW_ROOT/hooks"
  fi
  register_pass_hook install

  link_skills_into "$CLAUDE_HOME" "claude"

  if [ -d "$OPENCODE_HOME" ]; then
    head1 "OpenCode detected at $OPENCODE_HOME"
    note "the same skills, so an agent there works to the same standards"
    link_skills_into "$OPENCODE_HOME" "opencode"
  else
    note "OpenCode not installed — skipping ($OPENCODE_HOME)"
  fi

  if [ -d "$GEMINI_HOME" ] || [ -d "$GEMINI_CLI_HOME" ]; then
    head1 "Gemini / Antigravity detected"
    [ -d "$GEMINI_HOME" ] && link_skills_into "$GEMINI_HOME" "gemini"
    [ -d "$GEMINI_CLI_HOME" ] && link_skills_into "$GEMINI_CLI_HOME" "antigravity-cli"
  else
    note "Gemini not installed — skipping ($GEMINI_HOME)"
  fi

  head1 "Global gitignore"
  mkdir -p "$(dirname "$GIT_IGNORE_GLOBAL")"
  local patterns=("CLAUDE.local.md" "AGENTS.local.md" "GEMINI.local.md" "OPENCODE.local.md" ".claude/settings.local.json" ".atl/" ".fw/" "contract-drift.md" "graphify-out/")
  touch "$GIT_IGNORE_GLOBAL"
  for pattern in "${patterns[@]}"; do
    if grep -qxF "$pattern" "$GIT_IGNORE_GLOBAL"; then
      ok "already ignored: $pattern"
    else
      printf '%s\n' "$pattern" >> "$GIT_IGNORE_GLOBAL"
      ok "added to global ignore: $pattern"
    fi
  done

  head1 "Done. Run 'fw install' inside a project."
}

cmd_install() {
  local mode=auto dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --shared)   mode=shared ;;
      --personal) mode=personal ;;
      --dry-run)  dry=1 ;;
      *) bad "unknown flag: $1"; exit 2 ;;
    esac
    shift
  done

  head1 "Project: $(pwd)"

  if [ ! -f package.json ]; then
    bad "no package.json here"
    note "scaffold first, then install — the framework describes how to build, not how to create a repo"
    note "  bun create next-app@latest <name>"
    note "  bunx @angular/cli@22 new <name>"
    exit 1
  fi

  local stacks; mapfile -t stacks < <(detect_stacks)
  if [ "${#stacks[@]}" -eq 0 ] || [ -z "${stacks[0]}" ]; then
    warn "no known stack detected in package.json"
    note "expected one of: next, react, @angular/core, @nestjs/core, astro"
  else
    for s in "${stacks[@]}"; do ok "stack detected: $s"; done
  fi

  [ "$mode" = auto ] && mode="$(detect_sharing)"
  local target_claude target_agents target_gemini target_docs target
  if [ "$mode" = shared ]; then
    target_claude="CLAUDE.local.md"
    target_agents="AGENTS.local.md"
    target_gemini="GEMINI.local.md"
    target_docs=".fw/docs"
    ok "repository looks shared — installing privately"
    note "$(git log --format='%ae' 2>/dev/null | sort -u | wc -l | tr -d ' ') distinct commit authors"
  else
    target_claude="CLAUDE.md"
    target_agents="AGENTS.md"
    target_gemini="GEMINI.md"
    target_docs="docs"
    ok "repository looks personal — installing normally"
  fi

  head1 "Plan"
  note "$target_claude          <- framework rules for Claude"
  note "$target_agents          <- framework rules for OpenCode / Agents"
  note "$target_gemini          <- framework rules for Gemini / Antigravity"
  note "$target_docs/           <- framework docs"
  note "rules and skills        <- already global, nothing copied here"
  if [ -f "$PROJECT_RULES" ]; then
    note "$PROJECT_RULES      -> appended to the three above, never overwritten"
  fi

  # Every file we are about to write gets the same ownership check. AGENTS.md is
  # a cross-tool convention and GEMINI.md is Gemini's own context file, so both
  # plausibly exist as someone's hand-written work before this ever runs.
  for target in "$target_claude" "$target_agents" "$target_gemini"; do
    [ -e "$target" ] || continue
    grep -q 'Framework Rules' "$target" 2>/dev/null && continue
    head1 "Aborted"
    bad "$target exists and was not written by this framework"
    note "nothing was written — a half install leaves files in someone else's repo"
    if [ "$mode" = personal ]; then
      note "that file belongs to the project, which makes this a shared repository"
      note "install privately instead:  fw install --shared"
    else
      note "merge it by hand, or move it aside and rerun"
    fi
    exit 1
  done

  if [ -d "$target_docs" ] && [ -n "$(ls -A "$target_docs" 2>/dev/null)" ] \
     && [ ! -f "$target_docs/.fw-owned" ]; then
    head1 "Aborted"
    bad "$target_docs/ already exists and was not written by this framework"
    note "holds: $(ls -1 "$target_docs" | head -3 | tr '\n' ' ')"
    note "nothing was written — merging into it would mix our files with theirs,"
    note "and any later cleanup would take theirs with ours"
    note "install privately instead:  fw install --shared"
    exit 1
  fi

  # The checks run before this so --dry-run reports the abort it would hit.
  if [ "$dry" = 1 ]; then head1 "Dry run — nothing written."; return; fi

  head1 "Writing"
  # The three files below are disposable: each is rebuilt from the framework
  # rules plus $PROJECT_RULES, and neither source is one of them. Project rules
  # survive a reinstall because no code path here writes the file they live in,
  # not because a check happened to spare them.
  compose_rules() {
    local out="$1"
    cat "$FW_ROOT/CLAUDE.md" > "$out"
    [ -f "$PROJECT_RULES" ] || return 0
    printf '\n---\n\n' >> "$out"
    cat "$PROJECT_RULES" >> "$out"
  }

  compose_rules "$target_claude"
  ok "$target_claude"
  compose_rules "$target_agents"
  ok "$target_agents (OpenCode / Agents)"
  compose_rules "$target_gemini"
  ok "$target_gemini (Gemini / Antigravity)"

  if [ -f "$PROJECT_RULES" ]; then
    ok "$PROJECT_RULES appended to all three (fw never writes this file)"
  else
    note "no $PROJECT_RULES here — put rules only this project has in one,"
    note "and every reinstall will fold them back in"
  fi

  mkdir -p "$target_docs"
  : > "$target_docs/.fw-owned"
  # A document that does not apply to the detected stack is not harmless: it
  # competes with the one that does. angular.md says so in its own second line.
  local skipped=()
  for doc in "$FW_ROOT"/docs/*.md; do
    local name; name="$(basename "$doc")"
    case "$name" in
      angular.md)
        case " ${stacks[*]} " in *" angular "*) ;; *) skipped+=("$name"); continue ;; esac ;;
      clean-architecture.md)
        [ "${stacks[*]}" = "astro" ] && { skipped+=("$name"); continue; } ;;
    esac
    cp "$doc" "$target_docs"/
  done

  ok "$target_docs/ ($(ls -1 "$target_docs"/*.md 2>/dev/null | wc -l | tr -d ' ') files)"
  if [ "${#skipped[@]}" -gt 0 ]; then
    note "not installed, does not apply here: ${skipped[*]}"
    [ "${stacks[*]}" = "astro" ] && note "a content site has no domain to protect; the planning, testing and diagnosis skills are global and still apply"
  fi

  cmd_doctor
}

check_drift() {
  local live="$1" tracked="$2" name; name="$(basename "$live")"

  if [ ! -f "$live" ]; then warn "$name not on this machine"; return; fi
  if [ ! -f "$tracked" ]; then warn "$name not tracked — copy it into machine/"; return; fi

  # --strip-trailing-cr: a checkout on Windows can rewrite the tracked copy with
  # CRLF, and a byte comparison would then report drift that does not exist.
  if diff -q --strip-trailing-cr "$live" "$tracked" >/dev/null 2>&1; then
    ok "$name matches the tracked copy"
  else
    warn "$name has drifted from machine/$(basename "$tracked")"
    note "refresh with: cp $live $tracked"
  fi
}

cmd_doctor() {
  head1 "Checking install"

  local linked=0
  for rule in "$CLAUDE_HOME"/rules/fw-*.md; do
    [ -L "$rule" ] || continue
    if [ -e "$rule" ]; then ok "rule linked: $(basename "$rule")"; linked=1
    else bad "broken symlink: $rule"; fi
  done
  [ "$linked" = 0 ] && warn "no framework rules linked — run 'fw link'"

  # A rule added to the repository after the last `fw link` is not installed,
  # and its absence is invisible: it simply never loads, and the session that
  # needed it looks exactly like a session where it did not apply. Checking only
  # that the existing symlinks resolve verifies yesterday's install, never
  # today's rules.
  if [ "$linked" = 1 ]; then
    local repo_rule repo_name unlinked=0
    for repo_rule in "$FW_ROOT"/rules/*.md; do
      [ -e "$repo_rule" ] || continue
      repo_name="fw-$(basename "$repo_rule")"
      [ -e "$CLAUDE_HOME/rules/$repo_name" ] && continue
      bad "rule not linked: $repo_name"
      unlinked=1
    done
    [ "$unlinked" = 1 ] && note "a rule added since the last link never loads — run 'fw link'"
  fi

  local hook_script; hook_script="$(plan_hook_script)"
  if [ -f "$hook_script" ]; then
    ok "plan hook present: $(basename "$hook_script")"
  else
    bad "plan hook missing: $hook_script"
  fi
  # The hook shells out to the router on every prompt. A missing router is
  # silent by construction — prompts keep working and skills simply stop being
  # named, which is indistinguishable from no skill matching.
  if [ -f "$FW_ROOT/hooks/skill-router.py" ]; then
    ok "skill router present: skill-router.py"
  else
    bad "skill router missing: $FW_ROOT/hooks/skill-router.py"
  fi
  register_plan_hook check

  # The Stop hook is the only push channel the manual pass has. Missing, it is
  # silent by construction: the turn ends exactly as it did before, so a pass
  # that never happened looks like a pass that was not needed.
  local pass_script; pass_script="$(hook_script pass-guard)"
  if [ -f "$pass_script" ]; then
    ok "pass hook present: $(basename "$pass_script")"
  else
    bad "pass hook missing: $pass_script"
  fi
  register_pass_hook check

  count_linked_skills() {
    local home="$1" n=0
    for skill in "$home"/skills/*/; do
      [ -L "${skill%/}" ] || continue
      case "$(readlink -f "${skill%/}")" in "$FW_ROOT"/*) n=$((n+1)) ;; esac
    done
    printf '%s' "$n"
  }

  local total; total=$(ls -d "$FW_ROOT"/skills/*/ 2>/dev/null | wc -l | tr -d ' ')
  local claude_n; claude_n=$(count_linked_skills "$CLAUDE_HOME")
  if [ "$claude_n" -eq "$total" ]; then ok "claude: $claude_n/$total skills linked"
  elif [ "$claude_n" = 0 ]; then warn "claude: no framework skills linked — run 'fw link'"
  else bad "claude: only $claude_n/$total skills linked — run 'fw link'"; fi

  if [ -d "$OPENCODE_HOME" ]; then
    local oc_n; oc_n=$(count_linked_skills "$OPENCODE_HOME")
    if [ "$oc_n" -eq "$total" ]; then ok "opencode: $oc_n/$total skills linked"
    elif [ "$oc_n" = 0 ]; then bad "opencode: installed but has none of the skills — run 'fw link'"
    else bad "opencode: only $oc_n/$total skills linked — run 'fw link'"; fi
  fi

  # Two separate installs, so two separate lines. Folding them into one count
  # lets a fully linked home hide an empty one behind a green check.
  if [ -d "$GEMINI_HOME" ]; then
    local gem_n; gem_n=$(count_linked_skills "$GEMINI_HOME")
    if [ "$gem_n" -eq "$total" ]; then ok "gemini: $gem_n/$total skills linked"
    elif [ "$gem_n" = 0 ]; then bad "gemini: installed but has none of the skills — run 'fw link'"
    else bad "gemini: only $gem_n/$total skills linked — run 'fw link'"; fi
  fi

  if [ -d "$GEMINI_CLI_HOME" ]; then
    local ag_n; ag_n=$(count_linked_skills "$GEMINI_CLI_HOME")
    if [ "$ag_n" -eq "$total" ]; then ok "antigravity-cli: $ag_n/$total skills linked"
    elif [ "$ag_n" = 0 ]; then bad "antigravity-cli: installed but has none of the skills — run 'fw link'"
    else bad "antigravity-cli: only $ag_n/$total skills linked — run 'fw link'"; fi
  fi

  if [ -f "$GIT_IGNORE_GLOBAL" ] && grep -qxF '.fw/' "$GIT_IGNORE_GLOBAL"; then
    ok "global gitignore configured"
  else
    bad "global gitignore missing entries — run 'fw link'"
  fi

  check_drift "$HOME/.gentle-ai/state.json" "$FW_ROOT/machine/gentle-ai-state.json"
  check_drift "$HOME/.claude/settings.json" "$FW_ROOT/machine/claude-settings.json"

  if [ -d .fw/product ]; then
    if git rev-parse --git-dir >/dev/null 2>&1 && \
       [ -n "$(git ls-files .fw 2>/dev/null)" ]; then
      bad ".fw/ is TRACKED in this repository — product notes are in its history"
      note "untrack them: git rm -r --cached .fw"
    else
      ok "product artifacts present and untracked"
    fi
  fi

  if git rev-parse --git-dir >/dev/null 2>&1; then
    local leaked
    leaked=$(git status --porcelain 2>/dev/null | grep -E 'CLAUDE\.local\.md|AGENTS\.local\.md|GEMINI\.local\.md|OPENCODE\.local\.md|^\?\? \.fw/|^\?\? \.atl/' || true)
    if [ -n "$leaked" ]; then
      bad "personal files are visible to git:"
      printf '%s\n' "$leaked" | sed 's/^/      /'
      note "already tracked? untrack with: git rm --cached <file>"
    else
      ok "nothing personal is visible to git"
    fi
  fi

  [ "$FW_BAD" -eq 0 ] || { head1 "$FW_BAD problem(s) found"; return 1; }
}

pkg_script() {
  [ -f package.json ] || return 1
  grep -qE "\"$1\"[[:space:]]*:" <(sed -n '/"scripts"/,/}/p' package.json)
}

runner() {
  if [ -f bun.lock ] || [ -f bun.lockb ]; then echo bun
  elif [ -f pnpm-lock.yaml ]; then echo pnpm
  else echo npm; fi
}

EV_ROWS=()
EV_FAILED=0
EV_GAPS=0

# A check that could not run is reported in the table, with its reason, and not
# only on the terminal. The terminal scrolls away; the table is what gets pasted
# into the report, and a table that simply omits `lint` reads as a project whose
# lint passed. `../skills/verification-standards/SKILL.md`: never as a warning
# that reads like passing.
#
# An optional artifact is still listed — a reader cannot tell "no contracts run"
# from "contracts passed" otherwise — but it does not lower the verdict, or
# every frontend project would sit permanently at PASS WITH WARNINGS and the
# signal would mean nothing.
ev_missing() {
  local label="$1" reason="$2" optional="${3:-}"
  EV_ROWS+=("| $label | — | — | **NOT RUN** — $reason |")
  if [ -n "$optional" ]; then
    note "$label — NOT RUN — $reason"
  else
    EV_GAPS=$((EV_GAPS + 1))
    warn "$label — NOT RUN — $reason"
  fi
}

summarize() {
  local out="$1" rc="$2" plain line count
  plain="$(sed 's/\x1b\[[0-9;]*m//g' "$out")"

  line=$(printf '%s\n' "$plain" | grep -E '^[[:space:]]*Tests[[:space:]]+[0-9]' | tail -1 || true)
  if [ -n "$line" ]; then
    line="$(printf '%s' "$line" \
      | sed 's/^[[:space:]]*Tests[[:space:]]*//; s/[[:space:]]*|[[:space:]]*/, /g' \
      | tr -s ' ')"
    # `Tests 297 passed` beside `Errors 1 error` is the runner reporting that
    # every assertion held while something threw outside one — a stub missing a
    # method, a timer firing after teardown. Code did not run the way the test
    # believed it did. Pasted as "297 passed" it reads as success, so the count
    # travels with it.
    count=$(printf '%s\n' "$plain" \
      | sed -n 's/^[[:space:]]*Errors[[:space:]]\{1,\}\([0-9]\{1,\}\)[[:space:]]\{1,\}error.*/\1/p' | tail -1)
    if [ -n "$count" ] && [ "$count" != 0 ]; then
      printf '%s, %s unhandled error(s)' "$line" "$count"
    else
      printf '%s' "$line"
    fi
    return
  fi

  count=$(printf '%s\n' "$plain" | grep -cE 'error TS[0-9]+' || true)
  if [ "$count" -gt 0 ]; then printf '%s type error(s)' "$count"; return; fi

  # Best-effort label only. Every bundler names its failure differently and no
  # list of patterns stays complete — which is why the verdict comes from the
  # exit code of the real build, never from matching its output.
  line=$(printf '%s\n' "$plain" | grep -oE 'failed with [0-9]+ error' | tail -1 || true)
  if [ -n "$line" ]; then printf '%s(s)' "$line"; return; fi

  count=$(printf '%s\n' "$plain" | grep -cE '(^|[[:space:]])(X[[:space:]]+)?\[ERROR\]|^ERROR in |Build error occurred' || true)
  if [ "$count" -gt 0 ]; then printf '%s build error(s)' "$count"; return; fi

  line=$(printf '%s\n' "$plain" | grep -oE '[0-9]+ problems?( \([0-9]+ errors?)?' | tail -1 || true)
  if [ -n "$line" ]; then printf '%s' "$line"; return; fi

  count=$(printf '%s\n' "$plain" | grep -cE '^(DRIFT|UNREACHABLE)[[:space:]]' || true)
  if [ "$count" -gt 0 ]; then printf '%s contract(s) drifted' "$count"; return; fi

  if [ "$rc" -eq 0 ]; then printf 'clean'; else printf 'see output'; fi
}

run_check() {
  local label="$1" command="$2"
  local out rc
  out=$(mktemp)
  set +e
  eval "$command" >"$out" 2>&1
  rc=$?
  set -e

  local summary; summary="$(summarize "$out" "$rc")"

  # The exit code is one signal, not the verdict. A runner that reports an
  # unhandled error has told you code ran differently than the test believed,
  # and whether it also chose to exit non-zero is that runner's decision, not
  # evidence. Reading the result rather than the exit code is the reason this
  # table exists at all.
  local failed=0
  [ "$rc" -ne 0 ] && failed=1
  case "$summary" in *"unhandled error"*) failed=1 ;; esac
  [ "$failed" -eq 1 ] && EV_FAILED=1

  EV_ROWS+=("| $label | \`$command\` | $rc | $summary |")

  if [ "$failed" -eq 0 ]; then ok "$label — exit 0 — $summary"
  else
    bad "$label — exit $rc — $summary"
    sed 's/^/      /' "$out" | tail -12
  fi
  rm -f "$out"
}

cmd_evidence() {
  local skip_build=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-build) skip_build=1 ;;
      *) bad "unknown flag: $1"; exit 2 ;;
    esac
    shift
  done

  local rt; rt="$(runner)"
  head1 "Collecting evidence in $(pwd)"

  if [ ! -f package.json ]; then bad "no package.json here"; exit 1; fi

  if pkg_script typecheck; then run_check "typecheck" "$rt run typecheck"
  elif [ -f tsconfig.json ]; then run_check "typecheck" "${rt}x tsc --noEmit"
  else ev_missing "typecheck" "no typecheck script and no tsconfig.json"; fi

  # A project with no linter has a whole class of defect nobody is looking at —
  # unused imports, unreachable branches, shadowed names — and the table has to
  # say so, because "no lint row" and "lint passed" are indistinguishable to
  # whoever reads the report.
  if pkg_script lint; then run_check "lint" "$rt run lint"
  else ev_missing "lint" "no lint script in package.json"; fi

  # A build is not a typecheck. tsc --noEmit never sees an Angular template
  # error, an unresolved asset, or anything the bundler alone resolves — and a
  # broken build reported green is what this table exists to make impossible.
  if [ "$skip_build" = 1 ]; then
    ev_missing "build" "skipped by --no-build"
  elif pkg_script build; then run_check "build" "$rt run build"
  else ev_missing "build" "no build script in package.json"; fi

  if pkg_script test; then run_check "tests" "$rt run test"
  else ev_missing "tests" "no test script in package.json"; fi

  # An audit script decides which controls get reviewed at all, so a blind spot
  # in it is worth more than a blind spot in any single test — and it is the one
  # instrument nothing was testing.
  #
  # What runs here is the audit's SUITE, never the audit itself. An audit with
  # open findings is a project with work left, not a broken run; making evidence
  # fail on it would train everyone to delete the row. Its suite answers the
  # only question this table can ask: does the instrument still detect what it
  # claims to detect?
  local audit_dir=""
  for path in .fw/audit audit; do
    [ -d "$path" ] || continue
    audit_dir="$path"
    break
  done
  if [ -n "$audit_dir" ]; then
    if [ -x "$audit_dir/tests/run.sh" ]; then
      run_check "audit" "./$audit_dir/tests/run.sh"
    elif [ -f "$audit_dir/tests/run.sh" ]; then
      ev_missing "audit" "$audit_dir/tests/run.sh is not executable"
    else
      ev_missing "audit" "$audit_dir/ has no tests/run.sh"
    fi
  fi

  local contracts_ran=0
  for path in .fw/contracts/verify.ts contracts/verify.ts; do
    [ -f "$path" ] || continue
    run_check "contracts" "$rt run $path"
    contracts_ran=1
    break
  done
  if [ "$contracts_ran" -eq 0 ]; then
    ev_missing "contracts" "no .fw/contracts/verify.ts" optional
  fi

  # PASS means every check ran and passed. It cannot also mean "everything that
  # happened to run passed", or the word stops carrying the only claim anyone
  # reads it for.
  local verdict
  if [ "$EV_FAILED" -ne 0 ]; then verdict=FAIL
  elif [ "$EV_GAPS" -gt 0 ]; then verdict="PASS WITH WARNINGS"
  else verdict=PASS; fi

  head1 "Paste this into the verification report"
  printf '\n## Verification Evidence\n\n'
  printf 'Collected: %s\n' "$(date -Iseconds)"
  printf 'Commit: %s\n\n' "$(git rev-parse --short HEAD 2>/dev/null || echo 'not a git repository')"
  printf '| Check | Command | Exit | Result |\n|---|---|---|---|\n'
  if [ "${#EV_ROWS[@]}" -gt 0 ]; then printf '%s\n' "${EV_ROWS[@]}"; fi
  printf '\n**Verdict: %s**\n\n' "$verdict"
  if [ "$EV_GAPS" -gt 0 ]; then
    printf '%s check(s) could not run, listed above as NOT RUN. A check that did\n' "$EV_GAPS"
    printf 'not run is not a check that passed, so this verdict claims less than\n'
    printf 'PASS and those rows say how much less.\n\n'
  fi

  [ "$EV_FAILED" -eq 0 ] || exit 1
}

# ---------------------------------------------------------------------------
# fw pass
#
# The manual pass over the running app produces the most expensive findings a
# session gets — three of one day's four came from looking at the screen, not at
# the code — and the framework named it nowhere. It had no list to work from and
# no place to write what it found.
#
# Two halves, and only one of them is a person's job. The list comes from the
# diff, mechanically. The finding is written the moment it is seen, with the
# second field that makes it worth more than a bug report: which instrument
# should have caught this. When that field is empty, the item is not a bug — it
# is the framework's next piece of work.
#
# The retro is then assembled from the log instead of from memory at the end of
# a ten-hour day, which is what loses the repetitions: what gets remembered is
# what was startling, never what was frequent.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# fw split
#
# Splitting a finished piece of work into reviewable commits is two jobs. What
# the units are is judgement — `skills/work-units/`. Whether the split lost
# anything is not, and it is the half that goes wrong silently: a file dropped
# from a `git add`, a hunk staged into the wrong commit, an intermediate commit
# that does not even parse. Nothing about a clean `git log` reveals any of them.
#
# Both checks here were invented by hand during a real four-way split and are
# the only reason it could be claimed correct rather than hoped correct.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# fw review
#
# `CLAUDE.md` §1.2 says the dependency rule is "verifiable, not aspirational —
# check the imports in each layer before finishing", and nothing checked them.
# The rule that calls itself verifiable was the one rule with no verifier.
#
# It reads the ADDED lines of the diff, never the whole file. A violation that
# was already there is not this change's business — §4.4 forbids restructuring
# existing code as a side effect — and a reviewer buried in pre-existing
# findings stops reading the new ones.
# ---------------------------------------------------------------------------

REV_ROWS=()
REV_BAD=0

rev_row() {
  REV_ROWS+=("| $1 | $2 | $3 |")
  REV_BAD=$((REV_BAD + 1))
  bad "$1:$2 — $3"
}

# The layer a path belongs to, from the folder it lives in. Anything outside a
# known layer has no rule to break here.
rev_layer_of() {
  case "$1" in
    */domain/*)         printf 'domain' ;;
    */application/*)    printf 'application' ;;
    */infrastructure/*) printf 'infrastructure' ;;
    */presentation/*)   printf 'presentation' ;;
    *) printf '' ;;
  esac
}

# §1.2 warns that a text search for HttpClient also matches the comment saying a
# file must never import it, so only real import statements are read.
rev_import_target() {
  printf '%s' "$1" | sed -n "s/.*from[[:space:]]*['\"]\([^'\"]*\)['\"].*/\1/p;s/.*require([[:space:]]*['\"]\([^'\"]*\)['\"].*/\1/p" | head -1
}

# Every branch ends in an explicit return 0. A `grep && rev_row` as the last
# command makes the function return grep's status, and under set -e a file with
# no violation would kill the run — silently, after the findings printed so far.
rev_check_import() {
  local file="$1" line="$2" text="$3" layer target
  layer="$(rev_layer_of "$file")"
  [ -n "$layer" ] || return 0
  case "$text" in *import\ *|*require\(*) ;; *) return 0 ;; esac
  target="$(rev_import_target "$text")"
  [ -n "$target" ] || return 0

  case "$layer" in
    domain)
      # Pure: only other domain files. A bare specifier is a library. A relative
      # path is fine only while it stays inside domain/ — `../../../lib/supabase`
      # is the exact leak CLAUDE.md §1.2 names, and it leaves through `../`.
      case "$target" in
        ./*)
          : ;;
        ../*)
          case "$target" in
            *domain/*) : ;;
            *) rev_row "$file" "$line" "domain imports \`$target\` — it leaves domain/, and domain depends on nothing" ;;
          esac
          ;;
        *)
          rev_row "$file" "$line" "domain imports the library \`$target\` — domain declares its own types"
          ;;
      esac
      ;;
    application)
      if printf '%s' "$target" | grep -q 'presentation/'; then
        rev_row "$file" "$line" "application imports \`$target\` — input types belong to domain, never to a schema in presentation"
      fi
      ;;
    infrastructure)
      if printf '%s' "$target" | grep -qE '(application|presentation)/'; then
        rev_row "$file" "$line" "infrastructure imports \`$target\` — infrastructure may only depend on domain"
      fi
      ;;
    presentation)
      if printf '%s' "$target" | grep -q 'infrastructure/'; then
        rev_row "$file" "$line" "presentation imports \`$target\` — presentation goes through application"
      fi
      ;;
  esac
  return 0
}

# The tool-read comments are the declared exceptions in §5; everything else is a
# comment the rule forbids.
rev_comment_allowed() {
  printf '%s' "$1" | grep -qE '@ts-expect-error|@ts-ignore|eslint-disable|prettier-ignore|biome-ignore|^[[:space:]]*.?.?[[:space:]]*(Copyright|SPDX|License)|use (client|server)'
}

cmd_review() {
  git rev-parse --git-dir >/dev/null 2>&1 || { bad "not a git repository"; exit 1; }

  local base; base="$(pass_base)"
  head1 "Reviewing the added lines in $(pwd)"
  ok "comparing against $base"

  # A new file has no diff against anything, and a new file is the common case
  # for the layers this checks. Its whole content is added, so it is rendered as
  # such — read-only, without touching the index.
  local diff_out untracked f
  diff_out="$({ git diff -U0 "$base"...HEAD 2>/dev/null; git diff -U0 --cached 2>/dev/null; git diff -U0 2>/dev/null; } || true)"
  untracked="$(git ls-files --others --exclude-standard 2>/dev/null || true)"
  if [ -n "$untracked" ]; then
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      diff_out="$diff_out
+++ b/$f
@@ -0,0 +1,1 @@
$(sed 's/^/+/' "$f")"
    done <<EOF_UNTRACKED
$untracked
EOF_UNTRACKED
  fi
  if [ -z "$diff_out" ]; then
    warn "nothing added — there is nothing to review"
    return
  fi

  local file="" line=0 text
  while IFS= read -r text; do
    case "$text" in
      '+++ b/'*) file="${text#+++ b/}"; continue ;;
      '@@'*)
        line="$(printf '%s' "$text" | sed -n 's/^@@ -[0-9,]* +\([0-9]*\).*/\1/p')"
        [ -n "$line" ] || line=0
        continue ;;
      '+'*) ;;
      *) continue ;;
    esac
    [ -n "$file" ] || continue
    text="${text#+}"

    case "$file" in *.ts|*.tsx|*.js|*.jsx) ;; *) line=$((line + 1)); continue ;; esac
    case "$file" in *.test.*|*.spec.*|*.config.*) line=$((line + 1)); continue ;; esac

    rev_check_import "$file" "$line" "$text"

    # A barrel hides exactly the violations checked above.
    case "$file" in
      */features/*/index.ts) rev_row "$file" "$line" "a feature barrel hides dependency violations and breaks tree-shaking" ;;
    esac

    if printf '%s' "$text" | grep -qE ':[[:space:]]*any([^A-Za-z0-9_]|$)|<any>|as any([^A-Za-z0-9_]|$)'; then
      rev_row "$file" "$line" "\`any\` — use \`unknown\` and narrow"
    fi

    if printf '%s' "$text" | grep -qE '^[[:space:]]*(//|/\*|\*)' && ! rev_comment_allowed "$text"; then
      rev_row "$file" "$line" "a comment — rename or extract until the code does not need it"
    fi

    line=$((line + 1))
  done <<EOF_DIFF
$diff_out
EOF_DIFF

  head1 "What this cannot see"
  note "server state duplicated into Context or a store"
  note "a dependency added without asking"
  note "whether a criterion is actually met"
  note "these are read by a person — CLAUDE.md §6 lists the rest"

  local verdict; verdict=$([ "$REV_BAD" -eq 0 ] && echo PASS || echo FAIL)
  head1 "Paste this into the verification report"
  printf '\n## Review Evidence\n\n'
  printf 'Collected: %s\n' "$(date -Iseconds)"
  printf 'Base: %s\n\n' "$base"
  if [ "${#REV_ROWS[@]}" -gt 0 ]; then
    printf '| File | Line | Finding |\n|---|---|---|\n'
    printf '%s\n' "${REV_ROWS[@]}"
  else
    printf 'No violation of §1.2 or §5 in the added lines.\n'
  fi
  printf '\n**Verdict: %s**\n\n' "$verdict"
  printf 'Only the added lines are read. A violation that was already there is\n'
  printf 'not this change, and §4.4 forbids restructuring it as a side effect.\n\n'

  [ "$REV_BAD" -eq 0 ] || exit 1
}

SPLIT_ROOT=".fw/split"

split_sha() {
  sha256sum "$1" 2>/dev/null | cut -d' ' -f1 || shasum -a 256 "$1" 2>/dev/null | cut -d' ' -f1
}

split_dirty_files() {
  { git diff --name-only 2>/dev/null
    git diff --name-only --cached 2>/dev/null
    git ls-files --others --exclude-standard 2>/dev/null
  } | sed '/^$/d' | sort -u
}

# A file that cannot be parsed at a commit is a commit nobody can check out and
# run. Only languages with a real syntax check are claimed; the rest is reported
# as not checked rather than quietly counted as fine.
# 99 means "no checker for this kind of file", never "the check failed". A
# plain 2 collided with bash -n, which exits 2 on a syntax error — so a broken
# script was being counted as unverifiable and the run passed.
SPLIT_NO_CHECKER=99

split_syntax_check() {
  local file="$1" content="$2"
  case "$file" in
    *.sh|*.bash) bash -n "$content" 2>&1; return $? ;;
    *.py) python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$content" 2>&1; return $? ;;
    *.js|*.mjs|*.cjs)
      command -v node >/dev/null 2>&1 || return "$SPLIT_NO_CHECKER"
      node --check "$content" 2>&1; return $? ;;
    *.json) python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$content" 2>&1; return $? ;;
    *) return "$SPLIT_NO_CHECKER" ;;
  esac
}

split_start() {
  git rev-parse --git-dir >/dev/null 2>&1 || { bad "not a git repository"; exit 1; }
  local files; files="$(split_dirty_files)"
  if [ -z "$files" ]; then
    bad "nothing to split — the working tree is clean"
    exit 1
  fi

  mkdir -p "$SPLIT_ROOT"
  : > "$SPLIT_ROOT/files"
  local f n=0
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    printf '%s  %s\n' "$(split_sha "$f")" "$f" >> "$SPLIT_ROOT/files"
    n=$((n + 1))
  done <<EOF_F
$files
EOF_F
  git rev-parse HEAD > "$SPLIT_ROOT/base" 2>/dev/null || echo "" > "$SPLIT_ROOT/base"

  head1 "Split baseline recorded"
  ok "$n file(s) fingerprinted"
  ok "base commit $(cut -c1-8 < "$SPLIT_ROOT/base")"
  note "split into work units now — skills/work-units decides what those are"
  note "then:  fw split verify"
}

split_verify() {
  git rev-parse --git-dir >/dev/null 2>&1 || { bad "not a git repository"; exit 1; }
  if [ ! -f "$SPLIT_ROOT/files" ]; then
    bad "no baseline — run 'fw split start' before splitting, not after"
    note "without it there is nothing to compare against, and a lost file is invisible"
    exit 1
  fi

  local base; base="$(cat "$SPLIT_ROOT/base" 2>/dev/null)"
  head1 "Verifying the split"

  # 1. The content that existed before the split still exists, byte for byte.
  local drift=0 missing=0 total=0 sha file now
  while read -r sha file; do
    [ -n "$file" ] || continue
    total=$((total + 1))
    if [ ! -f "$file" ]; then
      bad "gone: $file"
      missing=$((missing + 1))
      continue
    fi
    now="$(split_sha "$file")"
    if [ "$now" != "$sha" ]; then
      bad "changed since the baseline: $file"
      drift=$((drift + 1))
    fi
  done < "$SPLIT_ROOT/files"
  if [ "$drift" -eq 0 ] && [ "$missing" -eq 0 ]; then
    ok "$total file(s) identical to the baseline — the split lost nothing"
  else
    note "a split may only move work between commits, never alter it. Fix the"
    note "content first; a verified split of the wrong bytes proves nothing."
  fi

  # 2. Nothing was left behind uncommitted.
  local left; left="$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$left" -eq 0 ]; then
    ok "working tree clean — every file reached a commit"
  else
    bad "$left path(s) still uncommitted"
    git status --porcelain | sed 's/^/      /'
  fi

  # 3. Every intermediate commit is checkable on its own. A split whose middle
  #    commits do not parse is a history nobody can bisect.
  head1 "Intermediate commits"
  local commits c checked=0 broken=0 skipped=0 tmp rc out
  commits="$(git log --format=%h "$base"..HEAD 2>/dev/null | tac)"
  if [ -z "$commits" ]; then
    warn "no commits since the baseline"
  else
    tmp="$(mktemp)"
    for c in $commits; do
      local bad_here=0
      while read -r sha file; do
        [ -n "$file" ] || continue
        git show "$c:$file" > "$tmp" 2>/dev/null || continue
        # set -e treats a failing command substitution in an assignment as
        # fatal, and a file that does not parse is exactly that — the run would
        # die at the first broken commit instead of reporting it.
        set +e
        out="$(split_syntax_check "$file" "$tmp" 2>&1)"; rc=$?
        set -e
        case "$rc" in
          0) checked=$((checked + 1)) ;;
          "$SPLIT_NO_CHECKER") skipped=$((skipped + 1)) ;;
          *) bad "$c — $file does not parse"
             printf '%s\n' "$out" | sed 's/^/        /' | head -3
             broken=$((broken + 1)); bad_here=1 ;;
        esac
      done < "$SPLIT_ROOT/files"
      [ "$bad_here" -eq 0 ] && ok "$c — $(git log -1 --format=%s "$c" | cut -c1-56)"
    done
    rm -f "$tmp"
    note "$checked file version(s) parsed, $skipped not checkable by syntax alone"
  fi

  local verdict
  if [ "$drift" -eq 0 ] && [ "$missing" -eq 0 ] && [ "$left" -eq 0 ] && [ "$broken" -eq 0 ]; then
    verdict=PASS
  else
    verdict=FAIL
  fi

  head1 "Paste this into the verification report"
  printf '\n## Split Evidence\n\n'
  printf 'Collected: %s\n' "$(date -Iseconds)"
  printf 'Base: %s\n' "$(printf '%s' "$base" | cut -c1-8)"
  printf 'Commits: %s\n\n' "$(printf '%s' "$commits" | wc -w | tr -d ' ')"
  printf '| Check | Result |\n|---|---|\n'
  printf '| content identical to baseline | %s of %s |\n' "$((total - drift - missing))" "$total"
  printf '| nothing left uncommitted | %s path(s) remaining |\n' "$left"
  printf '| intermediate commits parse | %s checked, %s broken, %s not checkable |\n' \
    "$checked" "$broken" "$skipped"
  printf '\n**Verdict: %s**\n\n' "$verdict"

  if [ "$verdict" = PASS ]; then
    rm -f "$SPLIT_ROOT/files" "$SPLIT_ROOT/base"
    note "baseline cleared"
  fi
  [ "$verdict" = PASS ] || exit 1
}

cmd_split() {
  case "${1:-}" in
    start)  shift; split_start "$@" ;;
    verify) shift; split_verify "$@" ;;
    *) bad "usage: fw split start | fw split verify"; exit 2 ;;
  esac
}

PASS_ROOT=".fw/pass"

pass_base() {
  # What to diff against, cheapest true answer first: the upstream branch is
  # what "already reviewed" means when there is one.
  git rev-parse --abbrev-ref '@{u}' 2>/dev/null && return 0
  git rev-parse --verify -q main >/dev/null 2>&1 && { printf 'main'; return 0; }
  git rev-parse --verify -q master >/dev/null 2>&1 && { printf 'master'; return 0; }
  printf 'HEAD'
}

pass_changed() {
  local base="$1"
  { git diff --name-only "$base"...HEAD 2>/dev/null
    git diff --name-only 2>/dev/null
    git ls-files --others --exclude-standard 2>/dev/null
  } | sed '/^$/d' | sort -u
}

# A file whose test sits beside it is already watched by something. One without
# is a file where the only check left is a person.
pass_has_test() {
  local f="$1" base dir
  base="$(basename "$f")"; base="${base%.*}"
  dir="$(dirname "$f")"
  compgen -G "$dir/$base.test.*" >/dev/null 2>&1 && return 0
  compgen -G "$dir/$base.spec.*" >/dev/null 2>&1 && return 0
  compgen -G "$dir/__tests__/$base.*" >/dev/null 2>&1 && return 0
  return 1
}

pass_log_file() {
  printf '%s/%s.md' "$PASS_ROOT" "$(date +%F)"
}

# The three reasons a changed file needs a person, as one machine-readable list:
# `kind<TAB>path`. `fw pass` prints it and the Stop hook fingerprints it. Two
# implementations of "what needs looking at" would drift, and the half that
# drifted would be the one nobody was reading.
pass_person_checkable() {
  local base="$1" files f
  files="$(pass_changed "$base")"
  [ -n "$files" ] || return 0

  printf '%s\n' "$files" | grep -E '\.(html|vue|svelte)$' | sed 's/^/template\t/' || true

  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in *.test.*|*.spec.*|*.d.ts) continue ;; esac
    case "$f" in *.ts|*.tsx|*.js|*.jsx) ;; *) continue ;; esac
    [ -f "$f" ] || continue
    pass_has_test "$f" && continue
    printf 'untested\t%s\n' "$f"
  done <<EOF_CLASSIFY
$files
EOF_CLASSIFY

  printf '%s\n' "$files" | grep -E '(routes?|menu|guard|nav|sidebar)' | sed 's/^/entry\t/' || true
}

# Machine-readable, for the Stop hook. Silent and exit 0 when nothing needs a
# person: a hook that speaks on every turn is a hook that gets ignored.
pass_porcelain() {
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  pass_person_checkable "$(pass_base)"
}

pass_note() {
  local text="" missed=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --missed) shift; missed="${1:-}" ;;
      -*) bad "unknown flag: $1"; exit 2 ;;
      *) text="${text:+$text }$1" ;;
    esac
    shift
  done
  if [ -z "$text" ]; then
    bad "nothing to record"
    note "fw pass note \"the toggle in Emission Docs is not gated\" --missed \"audit.py: blind to p-toggleswitch\""
    exit 2
  fi

  mkdir -p "$PASS_ROOT"
  local f; f="$(pass_log_file)"
  if [ ! -f "$f" ]; then
    printf '# Manual pass — %s\n\n' "$(date +%F)" > "$f"
    printf 'Written while looking at the app, not reconstructed afterwards.\n' >> "$f"
    printf 'The second line of each entry is what the retro is built from.\n\n' >> "$f"
  fi
  {
    printf -- '- %s · `%s`\n' "$(date +%H:%M)" "$(git rev-parse --short HEAD 2>/dev/null || echo 'no commit')"
    printf -- '  **Seen:** %s\n' "$text"
    if [ -n "$missed" ]; then
      printf -- '  **Should have caught it:** %s\n\n' "$missed"
    else
      printf -- '  **Should have caught it:** nothing exists — framework gap\n\n'
    fi
  } >> "$f"

  ok "recorded in $f"
  if [ -z "$missed" ]; then
    warn "no instrument named"
    note "that is not a gap in the note, it is the finding: nothing was watching this."
    note "it goes to the backlog as framework work, not as a bug."
  fi
}

pass_log() {
  local f; f="$(pass_log_file)"
  if [ "${1:-}" = "--all" ]; then
    head1 "Every pass recorded in $PASS_ROOT"
    local any=0 l
    for l in "$PASS_ROOT"/*.md; do
      [ -f "$l" ] || continue
      any=1
      printf '\n'; cat "$l"
    done
    [ "$any" = 1 ] || warn "nothing recorded yet"
    return
  fi
  if [ ! -f "$f" ]; then
    warn "nothing recorded today"
    note "fw pass note \"<what you saw>\" --missed \"<what should have caught it>\""
    return
  fi
  cat "$f"
}

cmd_pass() {
  case "${1:-}" in
    note) shift; pass_note "$@"; return ;;
    log)  shift; pass_log "$@"; return ;;
    --porcelain) pass_porcelain; return ;;
    "" ) ;;
    -*) ;;
    *) bad "unknown subcommand: $1"; exit 2 ;;
  esac

  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    bad "not a git repository — the list comes from the diff"
    exit 1
  fi

  local base; base="$(pass_base)"
  head1 "Manual pass in $(pwd)"
  ok "comparing against $base"

  local files; files="$(pass_changed "$base")"
  if [ -z "$files" ]; then
    warn "nothing changed — there is no pass to make"
    return
  fi

  local n; n="$(printf '%s\n' "$files" | wc -l | tr -d ' ')"
  ok "$n file(s) changed"

  # Grouped by feature, because a screen is a feature and files are not.
  head1 "Where to look"
  printf '%s\n' "$files" | sed -n 's|^\(.*features/[^/]*\)/.*|\1|p' | sort | uniq -c \
    | while read -r count dir; do note "$count file(s)  $dir"; done
  local outside
  outside="$(printf '%s\n' "$files" | grep -v 'features/' || true)"
  [ -n "$outside" ] && printf '%s\n' "$outside" | while read -r f; do note "          $f"; done

  local checkable
  checkable="$(pass_person_checkable "$base")"
  kind_of() { printf '%s\n' "$checkable" | sed -n "s/^$1\t//p"; }

  # A template is where a person is the only remaining check: no unit test sees
  # a layout, an empty state, or a control that renders but does nothing.
  head1 "Only a person can check these"
  local templates; templates="$(kind_of template)"
  if [ -n "$templates" ]; then
    printf '%s\n' "$templates" | while read -r f; do warn "$f"; done
  else
    note "no templates changed"
  fi

  head1 "Changed with no colocated test"
  local untested; untested="$(kind_of untested)"
  if [ -n "$untested" ]; then
    printf '%s\n' "$untested" | while read -r f; do warn "$f"; done
  else
    note "every changed source file has a test beside it"
  fi

  # A changed route, menu or guard moves who can reach what, and that is exactly
  # the claim a file cannot answer on its own.
  head1 "Entry points touched"
  local entries; entries="$(kind_of entry)"
  if [ -n "$entries" ]; then
    printf '%s\n' "$entries" | while read -r f; do bad "$f"; done
    note "who reaches what may have moved — skills/gating resolves it before you judge a control"
  else
    note "no route, menu or guard changed"
  fi

  head1 "While you look"
  note "fw pass note \"<what you saw>\" --missed \"<what should have caught it>\""
  note "the second field is the one the retro is built from. Empty means nothing"
  note "was watching it, which is a framework item and not a bug."
}

BACKLOG_FILE="${FW_BACKLOG:-$HOME/backlog.md}"
STALE_DAYS="${FW_STALE_DAYS:-3}"

cmd_backlog() {
  if [ "${1:-}" = "--init" ]; then
    if [ -f "$BACKLOG_FILE" ]; then
      bad "$BACKLOG_FILE already exists — left untouched"
      exit 1
    fi
    cat > "$BACKLOG_FILE" <<'SKELETON'
# Backlog

## Ready

## Blocked

## Not ready
SKELETON
    head1 "Created $BACKLOG_FILE"
    note "Ready     — passes the Definition of Ready, can be finished without asking anyone"
    note "Blocked   — waiting on an answer. Record the question and the date:"
    note "            (asked 2026-09-03) or (preguntado 2026-09-03). A bare date works too"
    note "Not ready — no criteria yet. Run the requirements skill on it first"
    return
  fi

  if [ ! -f "$BACKLOG_FILE" ]; then
    head1 "No backlog at $BACKLOG_FILE"
    note "create it with:  fw backlog --init"
    note "see skills/backlog/SKILL.md for what belongs in each section"
    exit 1
  fi

  local section="" ready=0 blocked=0 notready=0 stale=0
  local today; today=$(date +%s)

  # An item long enough to carry its context wraps, and a per-line reader drops
  # everything after the first line — including the date, which is the only
  # number the blocked bucket exists to show. A wait that silently reads as "no
  # date" is the same failure this command was written to end.
  local head="" body="" hsection=""

  head1 "Ready to start"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '- '*|'#'*|'') ;;
      *)
        # Indented continuation of the item above it.
        if [ -n "$head" ]; then
          body="$body ${line#"${line%%[![:space:]]*}"}"
          continue
        fi
        ;;
    esac

    bl_emit "$hsection" "$head" "$body"
    head=""; body=""

    case "$line" in
      '## Ready'*)     section=ready;     continue ;;
      '## Blocked'*)   section=blocked;   continue ;;
      '## Not ready'*) section=notready;  continue ;;
      '#'*)            section="";        continue ;;
    esac
    case "$line" in "- "*) ;; *) continue ;; esac

    head="${line#- }"; body="${line#- }"; hsection="$section"
  done < "$BACKLOG_FILE"
  bl_emit "$hsection" "$head" "$body"

  bl_report
}

# Split out so the reader above and the end of file agree on what an item is:
# `head` is what gets shown, `body` is head plus every continuation line, and
# the date is looked for in the body.
bl_emit() {
  local section="$1" text="$2" full="$3"
  [ -n "$text" ] || return 0
    case "$section" in
      ready)    ok "$text"; ready=$((ready+1)) ;;
      notready) notready=$((notready+1)) ;;
      blocked)
        blocked=$((blocked+1))
        local asked days
        # The marker may be written in any language, and a bare ISO date is
        # unambiguous without one. Demanding the English word made a Spanish
        # entry lose its wait in silence — and the days waiting is the only
        # number this bucket exists to show.
        asked=$(printf '%s' "$full" \
          | grep -oiE '(asked|preguntad[oa]|consultad[oa]|pedido)[[:space:]]+[0-9]{4}-[0-9]{2}-[0-9]{2}' \
          | tail -1 | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' || true)
        [ -n "$asked" ] || asked=$(printf '%s' "$full" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | tail -1 || true)
        if [ -n "$asked" ]; then
          days=$(( (today - $(date -d "$asked" +%s 2>/dev/null || echo "$today")) / 86400 ))
        else
          days=""
        fi
        BLOCKED_LINES+=("$days|$text")
        if [ -n "$days" ] && [ "$days" -ge "$STALE_DAYS" ]; then stale=$((stale+1)); fi
        ;;
    esac
}

bl_report() {
  # The backlog is an artifact like any other: it describes work, and it is
  # stale when the work moved after it did. It lives outside any repository, so
  # the only question that can be asked here is the blunt one — has anything
  # shipped since you last touched this list?
  if git rev-parse --git-dir >/dev/null 2>&1; then
    local bl_mt moved_since
    bl_mt="$(stat -c %Y "$BACKLOG_FILE" 2>/dev/null || stat -f %m "$BACKLOG_FILE" 2>/dev/null || echo 0)"
    if [ "$bl_mt" != 0 ]; then
      moved_since="$(git log --since="@$((bl_mt + 1))" --oneline 2>/dev/null | wc -l | tr -d ' ')"
      if [ -n "$moved_since" ] && [ "$moved_since" -gt 0 ]; then
        head1 "This list has not moved in $moved_since commit(s)"
        note "$(basename "$BACKLOG_FILE") was last touched before them, so Ready may already"
        note "be done and Blocked may already be answered. Read it before trusting it."
      fi
    fi
  fi

  if [ $((ready + blocked + notready)) -eq 0 ]; then
    note "the backlog is empty"
  elif [ "$ready" -eq 0 ]; then
    warn "nothing is ready — every item is blocked or missing criteria"
  fi

  head1 "Blocked, longest wait first"
  if [ "${#BLOCKED_LINES[@]}" -eq 0 ]; then
    note "nothing blocked"
  else
    printf '%s\n' "${BLOCKED_LINES[@]}" | sort -t'|' -k1,1nr | while IFS='|' read -r days text; do
      if [ -z "$days" ]; then
        warn "no date — $text"
      elif [ "$days" -ge "$STALE_DAYS" ]; then
        bad "${days}d — $text"
      else
        note "${days}d — $text"
      fi
    done
  fi

  head1 "Summary"
  note "ready $ready · blocked $blocked · not ready $notready"
  if [ "$stale" -gt 0 ]; then
    bad "$stale question(s) unanswered for $STALE_DAYS+ days — follow up on the oldest first"
  fi
  if [ "$notready" -gt 0 ]; then
    note "$notready item(s) need criteria before they can be judged — see skills/requirements/"
  fi
}

# ---------------------------------------------------------------------------
# fw mutate
#
# A green suite proves the tests ran. It does not prove they watch anything.
# This breaks the production code on purpose, one edit at a time, and requires
# the suite to go red. A mutation that survives is a hole with a green check
# over it — the most expensive kind, because you trust it.
#
# Two kinds of edit. The operator table asks whether a line is watched at all.
# --replace/--with asks the question a domain rule raises — does the suite
# notice this gate, this filter, this permission becoming a different one —
# which no operator flip can express, since both sides are the same operator.
#
# Same principle as `fw evidence`: verify the result, not the exit code.
# ---------------------------------------------------------------------------

MUT_ROWS=()
MUT_KILLED=0
MUT_SURVIVED=0
MUT_NOT_VIABLE=0
MUT_SKIPPED=0
MUT_OUT=""
MUT_ACTIVE_FILE=""
MUT_ACTIVE_BAK=""

# Restoring is not cleanup, it is the contract. A mutation left on disk after a
# crash or a Ctrl-C is corrupted source in someone's working tree.
mut_restore() {
  if [ -n "$MUT_ACTIVE_FILE" ] && [ -f "$MUT_ACTIVE_BAK" ]; then
    cp -f "$MUT_ACTIVE_BAK" "$MUT_ACTIVE_FILE"
    rm -f "$MUT_ACTIVE_BAK"
  fi
  MUT_ACTIVE_FILE=""
  MUT_ACTIVE_BAK=""
}

# from @@ to @@ label. Comparison operators require surrounding spaces so they
# never fire inside a generic (Map<string, T>), an arrow (=>) or JSX.
MUT_OPS=(
  " && @@ || @@\`&&\` to \`||\`"
  " || @@ && @@\`||\` to \`&&\`"
  " === @@ !== @@\`===\` to \`!==\`"
  " !== @@ === @@\`!==\` to \`===\`"
  " >= @@ < @@\`>=\` to \`<\`"
  " <= @@ > @@\`<=\` to \`>\`"
  " > @@ < @@\`>\` to \`<\`"
  " < @@ > @@\`<\` to \`>\`"
  " + @@ - @@\`+\` to \`-\`"
  "return true@@return false@@\`return true\` to \`return false\`"
  "return false@@return true@@\`return false\` to \`return true\`"
)

# A mutant that does not compile never reached the suite, so its exit code says
# nothing about whether a test was watching. Counting it as KILLED inflates the
# score exactly where the type system is strongest — which is the same mistake
# this command exists to catch: trusting the exit code instead of the result.
#
# The evidence is the output, so the output is read, not discarded. A mutant is
# only judged non-viable when a build/compile signature is present AND the
# runner never reported a test summary; if tests ran, a real failure wins.
mut_ran_tests() {
  grep -qE "Test Files[[:space:]]+[0-9]|Tests[[:space:]]+[0-9]|Tests:[[:space:]]+[0-9]|[0-9]+ (passing|passed|failing|failed)" "$1"
}

mut_compile_error() {
  grep -qE "error TS[0-9]{4}|TS[0-9]{4}:|bundle generation failed|Build failed|Transform failed|Could not resolve|Cannot find module|Pre-transform error" "$1"
}

mut_not_viable() {
  mut_compile_error "$1" && ! mut_ran_tests "$1"
}

mut_esc_pat()  { printf '%s' "$1" | sed 's/[][\\\/.*^$]/\\&/g'; }
mut_esc_repl() { printf '%s' "$1" | sed 's/[\\\/&]/\\&/g'; }

# A line that is a comment, an import or a type declaration carries no behavior,
# so a mutation there proves nothing about the tests.
mut_skip_line() {
  printf '%s' "$1" | grep -qE '^[[:space:]]*(//|\*|/\*|import |export type |type |interface )' && return 0
  return 1
}

mut_source_files() {
  local with_test=() without_test=() f base dir
  # A named replacement reaches template files too: an Angular gate lives in
  # the .html, and a sweep of .ts only would report that file clean because it
  # was never opened.
  local exts=( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.jsx' )
  [ "${1:-}" = html ] && exts+=( -o -name '*.html' )
  while IFS= read -r f; do
    base="$(basename "$f")"; base="${base%.*}"
    dir="$(dirname "$f")"
    if compgen -G "$dir/$base.test.*" >/dev/null 2>&1 ||
       compgen -G "$dir/$base.spec.*" >/dev/null 2>&1 ||
       compgen -G "$dir/__tests__/$base.*" >/dev/null 2>&1; then
      with_test+=("$f")
    else
      without_test+=("$f")
    fi
  done < <(
    find . \
      \( -path ./node_modules -o -path ./dist -o -path ./build -o -path ./.next \
         -o -path ./coverage -o -path ./.git -o -path ./.fw \) -prune -o \
      -type f \( "${exts[@]}" \) \
      ! -name '*.test.*' ! -name '*.spec.*' ! -name '*.d.ts' ! -name '*.config.*' \
      -print | sed 's|^\./||' | sort
  )
  # Files the suite claims to cover go first: that is where a survivor is news.
  printf '%s\n' "${with_test[@]:-}" "${without_test[@]:-}" | grep -v '^$' || true
}

cmd_mutate() {
  local max="" per_file="" test_cmd="" targets=()
  local from="" to="" with_seen=0 spec="" user_cmd=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --max)      shift; max="${1:-}" ;;
      --per-file) shift; per_file="${1:-}" ;;
      --test-cmd) shift; test_cmd="${1:-}"; user_cmd=1 ;;
      --replace)  shift; from="${1:-}" ;;
      --with)     shift; to="${1:-}"; with_seen=1 ;;
      --spec)     shift; spec="${1:-}" ;;
      -*) bad "unknown flag: $1"; exit 2 ;;
      *)  targets+=("$1") ;;
    esac
    shift
  done

  # An operator flip asks whether a line is watched at all. It cannot ask the
  # question a permission gate actually raises — does the suite notice
  # can('x.delete') becoming can('x.update') — because both sides are the same
  # operator. --replace points the identical machinery at a named edit.
  if [ -n "$from" ] && [ "$with_seen" -eq 0 ]; then
    bad "--replace needs --with"
    note "a mutation is a pair:  --replace \"can('a.delete')\" --with \"can('a.update')\""
    exit 2
  fi
  if [ -z "$from" ] && [ "$with_seen" -eq 1 ]; then
    bad "--with needs --replace"
    exit 2
  fi
  if [ -n "$from" ] && [ "$from" = "$to" ]; then
    bad "--replace and --with are the same string"
    note "that edit changes nothing, so a green suite after it proves nothing"
    exit 2
  fi

  # A named replacement is asked for deliberately and wants every occurrence:
  # the duplicated gate is the one that hides. The operator sweep keeps its
  # small default because it chooses its own targets.
  if [ -n "$from" ]; then
    max="${max:-50}"; per_file="${per_file:-50}"
  else
    max="${max:-10}"; per_file="${per_file:-3}"
  fi

  head1 "Mutating in $(pwd)"

  if [ ! -f package.json ]; then bad "no package.json here"; exit 1; fi

  local rt; rt="$(runner)"
  if [ -z "$test_cmd" ]; then
    if pkg_script test; then
      test_cmd="$rt run test"
    elif [ "$rt" = bun ]; then
      test_cmd="bun test"
    else
      bad "no test script in package.json"
      note "nothing to mutate against — a mutation needs a suite that can go red"
      note "pass one explicitly:  fw mutate --test-cmd '<command>'"
      exit 1
    fi
  fi
  # --spec narrows the suite to the file that should be watching. How a runner
  # forwards an argument is a guess, so it is not trusted: the baseline below
  # refuses to continue unless the scoped command reported an actual test run.
  if [ -n "$spec" ]; then
    if [ "$user_cmd" -eq 1 ] || [ "$test_cmd" = "bun test" ]; then
      test_cmd="$test_cmd $spec"
    else
      test_cmd="$test_cmd -- $spec"
    fi
  fi

  ok "package manager: $rt"
  ok "test command: $test_cmd"

  # Mutating a dirty file risks losing real work if this dies mid-run.
  if git rev-parse --git-dir >/dev/null 2>&1; then
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
      bad "working tree is dirty — commit or stash first"
      note "this rewrites source files in place and restores them; it will not"
      note "gamble with uncommitted work"
      exit 1
    fi
    ok "working tree clean"
  else
    warn "not a git repository — no safety net if this is interrupted"
  fi

  # A mutation score off a red baseline is meaningless: every mutant reads as
  # killed by a failure that was already there.
  head1 "Baseline"
  local t0 t1 baseline_secs base_out
  base_out="$(mktemp)"
  t0=$(date +%s)
  set +e
  eval "$test_cmd" >"$base_out" 2>&1
  local base_rc=$?
  set -e
  t1=$(date +%s)
  baseline_secs=$((t1 - t0))
  if [ "$base_rc" -ne 0 ]; then
    bad "suite is red before mutating (exit $base_rc)"
    note "fix the suite first — against a red baseline every mutant looks killed"
    rm -f "$base_out"; exit 1
  fi
  # Exit 0 from a runner that matched no spec file is byte-identical to a
  # passing suite. Every mutant would then SURVIVE against a suite that never
  # ran, and the report would name real files and real lines while proving
  # nothing.
  if [ -n "$spec" ] && ! mut_ran_tests "$base_out"; then
    bad "the scoped command exited 0 without reporting a test run"
    note "command: $test_cmd"
    note "green here means the runner found no test to run, not that one passed"
    note "check the path, or pass the whole invocation with --test-cmd"
    rm -f "$base_out"; exit 1
  fi
  rm -f "$base_out"
  ok "suite green in ${baseline_secs}s"

  head1 "Targets"
  if [ "${#targets[@]}" -eq 0 ]; then
    if [ -n "$from" ]; then
      mapfile -t targets < <(mut_source_files html)
    else
      mapfile -t targets < <(mut_source_files)
    fi
  fi
  if [ "${#targets[@]}" -eq 0 ] || [ -z "${targets[0]}" ]; then
    bad "no source files found to mutate"
    exit 1
  fi
  ok "${#targets[@]} candidate file(s), files with a colocated test first"

  # The forecast is the cost the caller is agreeing to, so it is counted rather
  # than assumed: --replace defaults to a budget of 50 and a string that occurs
  # twice must not be announced as fifty suite runs.
  local plan="$max" hits=0 c
  if [ -n "$from" ]; then
    for f in "${targets[@]}"; do
      [ -f "$f" ] || continue
      c="$(grep -cF -- "$from" "$f" 2>/dev/null || true)"
      hits=$((hits + ${c:-0}))
    done
    ok "$hits line(s) contain the string"
    [ "$hits" -lt "$plan" ] && plan="$hits"
  fi

  note "up to $plan mutation(s), at most $per_file per file, one full suite run each"
  note "forecast: about $((plan * (baseline_secs + 1)))s"

  # The from/to/label triples are unpacked once, here, so a caller-supplied
  # string is never parsed by the @@ convention the operator table uses: a
  # replacement containing @@ would otherwise be silently cut in half.
  local m_from=() m_to=() m_label=() op _t
  if [ -n "$from" ]; then
    m_from=("$from"); m_to=("$to")
    m_label=("\`$from\` to \`${to:-<removed>}\`")
  else
    for op in "${MUT_OPS[@]}"; do
      _t="${op#*@@}"
      m_from+=("${op%%@@*}"); m_to+=("${_t%%@@*}"); m_label+=("${op##*@@}")
    done
  fi

  head1 "Mutants"
  MUT_OUT="$(mktemp)"
  trap 'mut_restore; rm -f "$MUT_OUT"' EXIT INT TERM

  local done=0 in_file=0 f i mfrom mto label line content pat repl bak rc result
  for f in "${targets[@]}"; do
    [ "$done" -ge "$max" ] && break
    [ -f "$f" ] || continue
    in_file=0

    for i in "${!m_from[@]}"; do
      [ "$done" -ge "$max" ] && break
      [ "$in_file" -ge "$per_file" ] && break
      mfrom="${m_from[$i]}"; mto="${m_to[$i]}"; label="${m_label[$i]}"

      # Every occurrence is a candidate, not only the first. Duplicated logic —
      # the same guard copied into a second method — is exactly where a hole
      # hides, and a first-match-only sweep reports that file as clean.
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        [ "$done" -ge "$max" ] && break
        [ "$in_file" -ge "$per_file" ] && break

        content="$(sed -n "${line}p" "$f")"
        if mut_skip_line "$content"; then
          MUT_SKIPPED=$((MUT_SKIPPED + 1))
          continue
        fi

        bak="$(mktemp)"
        cp -f "$f" "$bak"
        MUT_ACTIVE_FILE="$f"; MUT_ACTIVE_BAK="$bak"

        pat="$(mut_esc_pat "$mfrom")"
        repl="$(mut_esc_repl "$mto")"
        sed -i "${line}s/${pat}/${repl}/" "$f"

        # If the edit changed nothing, no mutant existed. Counting it would
        # inflate the score with a run that proved nothing.
        #
        # Compare the mutated LINE, not the whole file: `sed -i` rewrites CRLF
        # sources as LF, so a whole-file comparison reports "changed" for an
        # edit that matched nothing and the run would score unmutated code.
        if [ "${content%$'
'}" = "$(sed -n "${line}p" "$f" | tr -d '
')" ]; then
          mut_restore
          continue
        fi

        set +e
        eval "$test_cmd" >"$MUT_OUT" 2>&1
        rc=$?
        set -e
        mut_restore

        if [ "$rc" -ne 0 ] && mut_not_viable "$MUT_OUT"; then
          result="NOT VIABLE"; MUT_NOT_VIABLE=$((MUT_NOT_VIABLE + 1))
          warn "$f:$line — $label — NOT VIABLE (never compiled)"
        elif [ "$rc" -ne 0 ]; then
          result="KILLED"; MUT_KILLED=$((MUT_KILLED + 1))
          ok "$f:$line — $label — KILLED"
        else
          result="SURVIVED"; MUT_SURVIVED=$((MUT_SURVIVED + 1))
          bad "$f:$line — $label — SURVIVED"
        fi
        MUT_ROWS+=("| \`$f\` | $line | $label | $rc | $result |")
        done=$((done + 1))
        in_file=$((in_file + 1))
      done < <(grep -nF -- "$mfrom" "$f" 2>/dev/null | cut -d: -f1 || true)
    done
  done

  trap - EXIT INT TERM
  rm -f "$MUT_OUT"

  local total=$((MUT_KILLED + MUT_SURVIVED))
  if [ "$total" -eq 0 ]; then
    # Mutants that were applied and rejected by the compiler are not the same
    # as operators that matched nothing. Reporting both as "nothing was
    # mutated" sends the reader to widen the target when the target was fine.
    if [ "$MUT_NOT_VIABLE" -gt 0 ]; then
      head1 "No mutant reached the suite"
      bad "$MUT_NOT_VIABLE mutant(s) applied, every one rejected by the compiler"
      note "the type system refused each edit, so the suite was never asked and"
      note "this run is no evidence either way — not a pass"
      note "try a file whose logic the types do not already guard"
      exit 1
    fi
    head1 "No mutants applied"
    if [ -n "$from" ]; then
      if [ "$MUT_SKIPPED" -gt 0 ]; then
        bad "the string appears $MUT_SKIPPED time(s), every one on a comment, import or type line"
        note "a mutation there carries no behavior, so none of them is evidence"
      else
        bad "the string never appears in the ${#targets[@]} file(s) searched"
        note "the match is literal, whitespace included:  $from"
      fi
    else
      bad "nothing was mutated — the operators matched no behavioral line"
      note "point it at a file directly:  fw mutate src/domain/totals.ts"
    fi
    exit 1
  fi

  local score=$(( MUT_KILLED * 100 / total ))
  local verdict; verdict=$([ "$MUT_SURVIVED" -eq 0 ] && echo PASS || echo FAIL)

  head1 "Paste this into the verification report"
  printf '\n## Mutation Evidence\n\n'
  printf 'Collected: %s\n' "$(date -Iseconds)"
  printf 'Commit: %s\n' "$(git rev-parse --short HEAD 2>/dev/null || echo 'not a git repository')"
  printf 'Test command: `%s`\n\n' "$test_cmd"
  printf '| File | Line | Mutation | Exit | Result |\n|---|---|---|---|---|\n'
  printf '%s\n' "${MUT_ROWS[@]}"
  printf '\nKilled %s · survived %s · not viable %s · mutation score %s%%\n' \
    "$MUT_KILLED" "$MUT_SURVIVED" "$MUT_NOT_VIABLE" "$score"
  printf 'Score is killed / (killed + survived). A mutant that never compiled is\n'
  printf 'excluded: it never reached the suite, so it is not evidence either way.\n\n'
  printf '**Verdict: %s**\n\n' "$verdict"

  if [ "$MUT_NOT_VIABLE" -gt 0 ]; then
    note "$MUT_NOT_VIABLE mutant(s) were rejected by the compiler. That is the type"
    note "system doing its job, not the suite — it is excluded from the score."
  fi

  if [ "$MUT_SURVIVED" -gt 0 ]; then
    note "each SURVIVED row is production code you can break with the suite green"
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# fw product
#
# Epics and user stories are the one artifact this framework produced only as
# chat. Chat is not a place: it cannot be reread next week, diffed, or pointed
# at from a criterion. This gives them a home.
#
# It lives under .fw/ because that is already the standing decision for anything
# this framework writes into someone else's repository — one namespace, covered
# by one global ignore rule. Nothing here reaches the project's git history.
# ---------------------------------------------------------------------------

PRODUCT_ROOT=".fw/product"

prod_slug_ok() { printf '%s' "${1:-}" | grep -qE '^[a-z0-9]+(-[a-z0-9]+)*$'; }

prod_status_of() {
  sed -n 's/^Status:[[:space:]]*//p' "$1" 2>/dev/null | head -1
}

prod_title_of() {
  sed -n 's/^#[[:space:]]*//p' "$1" 2>/dev/null | head -1
}

# An artifact that describes work is stale when the work moved after it did.
# That is mechanical: no judgement about whether the text is still true, only
# whether anything happened since it was written.
prod_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
}

# A story may name the paths it is about. When it does the question sharpens
# from "did anything happen" to "did its own code change", which is the
# difference between a hint and a finding — so the two are never reported with
# the same words.
prod_files_of() {
  sed -n 's/^Files:[[:space:]]*//p' "$1" 2>/dev/null | head -1
}

prod_stale_of() {
  local file="$1" mt paths
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  mt="$(prod_mtime "$file")"
  [ "$mt" != 0 ] || return 0
  paths="$(prod_files_of "$file")"
  # --since is inclusive, so a commit made in the same second as the artifact
  # would count as having come after it. An artifact written alongside its
  # commit is current, not stale.
  mt=$((mt + 1))
  if [ -n "$paths" ]; then
    # shellcheck disable=SC2086
    git log --since="@$mt" --oneline -- $paths 2>/dev/null | wc -l | tr -d ' '
  else
    git log --since="@$mt" --oneline 2>/dev/null | wc -l | tr -d ' '
  fi
}

prod_require_root() {
  if [ ! -d "$PRODUCT_ROOT" ]; then
    bad "no $PRODUCT_ROOT here"
    note "create it first:  fw product init"
    exit 1
  fi
}

prod_render() {
  local src="$1" dst="$2"; shift 2
  local body; body="$(cat "$src")"
  while [ $# -gt 0 ]; do
    body="${body//"$1"/"$2"}"
    shift 2
  done
  printf '%s\n' "$body" > "$dst"
}

prod_init() {
  head1 "Product artifacts in $(pwd)"

  if [ -f "$GIT_IGNORE_GLOBAL" ] && grep -qxF '.fw/' "$GIT_IGNORE_GLOBAL"; then
    ok ".fw/ is covered by the global gitignore"
  else
    bad ".fw/ is NOT in the global gitignore — run 'fw link' first"
    note "without it these files land in the project's history, which is exactly"
    note "what this directory exists to avoid"
    exit 1
  fi

  mkdir -p "$PRODUCT_ROOT/epics" "$PRODUCT_ROOT/criteria"
  ok "$PRODUCT_ROOT/epics/"
  ok "$PRODUCT_ROOT/criteria/"

  if [ ! -f "$PRODUCT_ROOT/README.md" ]; then
    cat > "$PRODUCT_ROOT/README.md" <<'READMEEOF'
# Product artifacts

Epics and user stories for this project. Invisible to git by design — `.fw/` is
covered by the global gitignore, so nothing here reaches the project's history.

```
epics/<slug>.md              boundary and standing decisions across slices
criteria/<slug>-NN.md        one user story: story, criteria, gaps, evidence
```

The layout is **flat on purpose**. An epic's `## Slices` table is the source of
truth for what belongs to it. Nesting stories inside per-epic directories would
record that same relationship twice — in the tree and in the table — and the two
drift the first time a slice is renamed.

```bash
fw product                   # what exists, and where each story stands
fw product epic checkout     # new epic
fw product hu checkout       # new story under it, row appended to the table
```

Do not maintain the slice list by hand; `fw product hu` appends to it.
READMEEOF
    ok "$PRODUCT_ROOT/README.md"
  else
    note "README.md already there — left untouched"
  fi

  head1 "Next"
  note "fw product epic <slug>    start an epic"
  note "fw product hu <slug>      add a story to it"
}

prod_epic() {
  local slug="${1:-}"; shift || true
  local title="${*:-}"

  if ! prod_slug_ok "$slug"; then
    bad "slug required, lowercase and dashed: fw product epic <slug> [title]"
    exit 2
  fi
  prod_require_root

  local dst="$PRODUCT_ROOT/epics/$slug.md"
  if [ -e "$dst" ]; then
    bad "$dst already exists — left untouched"
    exit 1
  fi

  [ -n "$title" ] || title="$slug"
  prod_render "$FW_ROOT/templates/product/epic.md" "$dst" \
    '{{NAME}}' "$title" '{{DATE}}' "$(date +%Y-%m-%d)"

  head1 "Epic created"
  ok "$dst"
  note "fill Outcome and Boundary before the first slice — 'Not in' is the half"
  note "that pays for itself"
}

prod_hu() {
  local epic="${1:-}"; shift || true
  local title="${*:-}"

  if ! prod_slug_ok "$epic"; then
    bad "epic slug required: fw product hu <epic-slug> [title]"
    exit 2
  fi
  prod_require_root

  local epic_file="$PRODUCT_ROOT/epics/$epic.md"
  if [ ! -f "$epic_file" ]; then
    bad "no epic '$epic' — create it first"
    note "fw product epic $epic"
    exit 1
  fi

  # Numbering follows the files on disk, never the table, so a hand-edited table
  # can never cause two stories to claim the same id.
  local n=0 f base num
  for f in "$PRODUCT_ROOT/criteria/$epic"-*.md; do
    [ -f "$f" ] || continue
    base="$(basename "$f" .md)"
    num="${base##*-}"
    case "$num" in ''|*[!0-9]*) continue ;; esac
    num=$((10#$num))
    [ "$num" -gt "$n" ] && n="$num"
  done
  n=$((n + 1))
  local id; id="$(printf '%s-%02d' "$epic" "$n")"
  local dst="$PRODUCT_ROOT/criteria/$id.md"

  [ -n "$title" ] || title="untitled"
  prod_render "$FW_ROOT/templates/product/hu.md" "$dst" \
    '{{ID}}' "$id" '{{NAME}}' "$title" '{{EPIC}}' "$epic" '{{DATE}}' "$(date +%Y-%m-%d)"

  # Append the row after the last table line so the epic's Slices table stays
  # the single place that lists what belongs to this epic.
  local last_row row tmp
  last_row="$(grep -n '^|' "$epic_file" | tail -1 | cut -d: -f1 || true)"
  row="| $n | [$title](../criteria/$id.md) | draft | — |"
  if [ -n "$last_row" ]; then
    tmp="$(mktemp)"
    head -n "$last_row" "$epic_file" > "$tmp"
    printf '%s\n' "$row" >> "$tmp"
    tail -n +$((last_row + 1)) "$epic_file" >> "$tmp"
    mv "$tmp" "$epic_file"
    ok "slice row appended to $epic_file"
  else
    warn "no table found in $epic_file — row not appended"
    note "$row"
  fi

  head1 "Story created"
  ok "$dst"
  note "criteria in EARS shape; a gap you cannot fill is a question, not a guess"
}

prod_list() {
  prod_require_root
  head1 "Product artifacts in $(pwd)"

  local found=0 epic_file slug title status story sid sstatus stitle n moved stale=0
  for epic_file in "$PRODUCT_ROOT"/epics/*.md; do
    [ -f "$epic_file" ] || continue
    found=1
    slug="$(basename "$epic_file" .md)"
    title="$(prod_title_of "$epic_file")"
    status="$(prod_status_of "$epic_file")"
    printf '\n  %s%s%s  %s\n' "$GREEN" "${title:-$slug}" "$OFF" "${DIM}${status:-no status}${OFF}"

    n=0
    for story in "$PRODUCT_ROOT/criteria/$slug"-*.md; do
      [ -f "$story" ] || continue
      n=$((n + 1))
      sid="$(basename "$story" .md)"
      stitle="$(prod_title_of "$story")"
      stitle="${stitle#"$sid" — }"
      sstatus="$(prod_status_of "$story")"
      printf '    %-28s %-10s %s\n' "$sid" "${sstatus:-draft}" "${DIM}${stitle}${OFF}"

      # A finished story is allowed to sit still; that is what finished means.
      case "${sstatus:-draft}" in
        done|Done|DONE|archived|Archived) ;;
        *)
          moved="$(prod_stale_of "$story")"
          if [ -n "$moved" ] && [ "$moved" -gt 0 ]; then
            stale=$((stale + 1))
            if [ -n "$(prod_files_of "$story")" ]; then
              bad "      $moved commit(s) touched its files since it was written, and it still says ${sstatus:-draft}"
            else
              warn "      $moved commit(s) since it was written, and it still says ${sstatus:-draft}"
              note "      declare  Files: <paths>  in it to ask about its own code instead of the whole repo"
            fi
          fi
          ;;
      esac
    done
    [ "$n" -eq 0 ] && note "no stories yet — fw product hu $slug"
  done

  if [ "$found" -eq 0 ]; then
    warn "no epics yet"
    note "fw product epic <slug>"
    return
  fi

  local orphan=0
  for story in "$PRODUCT_ROOT"/criteria/*.md; do
    [ -f "$story" ] || continue
    sid="$(basename "$story" .md)"
    slug="${sid%-*}"
    [ -f "$PRODUCT_ROOT/epics/$slug.md" ] && continue
    [ "$orphan" -eq 0 ] && head1 "Stories with no epic"
    orphan=1
    bad "$sid — no $PRODUCT_ROOT/epics/$slug.md"
  done
  if [ "$stale" -gt 0 ]; then
    head1 "$stale artifact(s) describe work that moved without them"
    note "a story left at draft while its code shipped is not documentation,"
    note "it is a claim nobody checked. Update the status or the criteria."
  fi

  [ "$orphan" -eq 0 ] || return 1
}

cmd_product() {
  case "${1:-list}" in
    init) shift; prod_init "$@" ;;
    epic) shift; prod_epic "$@" ;;
    hu)   shift; prod_hu "$@" ;;
    list) shift; prod_list "$@" ;;
    *) bad "unknown subcommand: $1"; note "init | epic | hu | list"; exit 2 ;;
  esac
}

BLOCKED_LINES=()

case "${1:-}" in
  backlog)  shift; cmd_backlog "$@" ;;
  pass)     shift; cmd_pass "$@" ;;
  split)    shift; cmd_split "$@" ;;
  review)   shift; cmd_review "$@" ;;
  link)     shift; cmd_link "$@" ;;
  install)  shift; cmd_install "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  evidence) shift; cmd_evidence "$@" ;;
  mutate)   shift; cmd_mutate "$@" ;;
  product)  shift; cmd_product "$@" ;;
  *)
    cat <<EOF
fw — install this framework into a project

  fw link              once per machine: symlink rules and skills, set global gitignore
  fw install           in a project: detect stack, write CLAUDE.md, AGENTS.md,
                       GEMINI.md and docs. PROJECT-RULES.md, if present, is
                       appended to all three and is never written by fw
    --shared           force private install (CLAUDE.local.md + .fw/docs)
    --personal         force normal install
    --dry-run          show the plan, write nothing
  fw doctor            verify the install and that nothing personal leaks into git
  fw evidence          run typecheck, lint, build, tests, the audit suite and
                       contracts; print a
                       pasteable evidence table. A check the project does not
                       have is a NOT RUN row, never a silent omission, and the
                       verdict drops to PASS WITH WARNINGS. Exits non-zero if
                       any check fails
    --no-build         skip the build; it is marked NOT RUN in the table
  fw mutate [files]    break the production code on purpose and require the
                       suite to go red. A green suite proves the tests ran, not
                       that they watch anything. Exits non-zero if any mutant
                       survives
    --replace <str>    mutate this exact string instead of the operator table,
                       for the edit an operator flip cannot express — a gate
                       moving from can('a.delete') to can('a.update')
    --with <str>       what it becomes; required with --replace
    --spec <path>      narrow the suite to one spec file. Refused if the scoped
                       command exits 0 without reporting a test run
    --max <n>          mutations to apply, default 10, or 50 with --replace
    --per-file <n>     cap one file's share, default 3, or 50 with --replace
    --test-cmd <cmd>   override the detected test command
  fw product           epics and user stories under .fw/product, invisible to git
    init               create .fw/product/ in this project
    epic <slug> [t]    start an epic
    hu <slug> [t]      add a story to it, appending its row to the epic table
    list               what exists and where each story stands (default)
  fw review            check the added lines against the rules CLAUDE.md calls
                       verifiable: the layer dependency rule, no comments, no
                       \`any\`, no feature barrels. Only added lines — a violation
                       that was already there is not this change
  fw split             prove a finished change was split into commits without
                       losing anything. What the units are is judgement —
                       skills/work-units; whether the split is sound is not
    start              fingerprint the working tree before splitting
    verify             content identical, nothing left behind, every
                       intermediate commit parses on its own
  fw pass              the manual pass over the running app: what changed, which
                       screens it lands on, what only a person can check
    note "<text>"      record a finding while looking at it
      --missed "<x>"   which instrument should have caught it. Empty means none
                       existed, which makes it framework work rather than a bug
    log [--all]        today's findings, or every day recorded
  fw backlog           what is ready to start, and how long each blocked item
                       has been waiting on an answer
                       FW_BACKLOG=<file>   default ~/backlog.md
                       FW_STALE_DAYS=<n>   default 3

Framework root: $FW_ROOT
EOF
    ;;
esac
