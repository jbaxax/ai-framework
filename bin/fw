#!/usr/bin/env bash
set -euo pipefail

FW_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
OPENCODE_HOME="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
GIT_IGNORE_GLOBAL="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"

# Git Bash's `ln -s` copies instead of symlinking on Windows unless this is
# set, even with Developer Mode on, because MSYS only calls the native
# CreateSymbolicLink API in this mode. Set it here so `fw link` works from any
# shell profile that invokes this script, not just ones that export it.
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*) export MSYS="${MSYS:-winsymlinks:nativestrict}" ;;
esac

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'

ok()   { printf '  %s✓%s %s\n' "$GREEN" "$OFF" "$1"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$OFF" "$1"; }
FW_BAD=0
bad()  { FW_BAD=$((FW_BAD+1)); printf '  %s✗%s %s\n' "$RED" "$OFF" "$1"; }
note() { printf '    %s%s%s\n' "$DIM" "$1" "$OFF"; }
head1(){ printf '\n%s\n' "$1"; }

link_or_warn() {
  local src="$1" dst="$2" label="$3"
  ln -sfn "$src" "$dst"
  if [ -L "$dst" ]; then
    ok "$label -> $src"
  else
    bad "$label -> $src (ln did not create a real symlink, got a copy instead)"
    note "Windows needs Developer Mode on AND MSYS=winsymlinks:nativestrict for ln -s to work"
  fi
}

has_dep() {
  [ -f package.json ] || return 1
  grep -qE "\"$1\"[[:space:]]*:" package.json
}

detect_stacks() {
  local found=()
  has_dep '@angular/core' && found+=(angular)
  has_dep 'next'          && found+=(react-next)
  if ! has_dep 'next' && has_dep 'react'; then found+=(react); fi
  has_dep '@nestjs/core'  && found+=(nest)
  has_dep 'astro'         && found+=(astro)
  printf '%s\n' "${found[@]:-}"
}

detect_sharing() {
  git rev-parse --git-dir >/dev/null 2>&1 || { echo personal; return; }
  local authors
  authors=$(git log --format='%ae' 2>/dev/null | sort -u | wc -l | tr -d ' ')
  if [ "$authors" -gt 1 ]; then echo shared; else echo personal; fi
}

link_skills_into() {
  local home="$1" label="$2"
  mkdir -p "$home/skills"
  for skill in "$FW_ROOT"/skills/*/; do
    [ -d "$skill" ] || continue
    local name; name="$(basename "$skill")"
    local target="$home/skills/$name"
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      bad "$label: skill $name exists and is NOT a symlink — left untouched"
      note "resolve by hand: $target"
      continue
    fi
    link_or_warn "${skill%/}" "$target" "$label: skill $name"
  done
}

cmd_link() {
  head1 "Linking framework into $CLAUDE_HOME (once per machine)"
  mkdir -p "$CLAUDE_HOME/rules"

  for rule in "$FW_ROOT"/rules/*.md; do
    [ -e "$rule" ] || continue
    local name="fw-$(basename "$rule")"
    link_or_warn "$rule" "$CLAUDE_HOME/rules/$name" "rule  $name"
  done

  link_skills_into "$CLAUDE_HOME" "claude"

  if [ -d "$OPENCODE_HOME" ]; then
    head1 "OpenCode detected at $OPENCODE_HOME"
    note "the same skills, so an agent there works to the same standards"
    link_skills_into "$OPENCODE_HOME" "opencode"
  else
    note "OpenCode not installed — skipping ($OPENCODE_HOME)"
  fi

  head1 "Global gitignore"
  mkdir -p "$(dirname "$GIT_IGNORE_GLOBAL")"
  local patterns=("CLAUDE.local.md" ".claude/settings.local.json" ".atl/" ".fw/" "contract-drift.md" "graphify-out/")
  touch "$GIT_IGNORE_GLOBAL"
  for pattern in "${patterns[@]}"; do
    if grep -qxF "$pattern" "$GIT_IGNORE_GLOBAL"; then
      ok "already ignored: $pattern"
    else
      printf '%s\n' "$pattern" >> "$GIT_IGNORE_GLOBAL"
      ok "added to global ignore: $pattern"
    fi
  done

  head1 "Done. Run 'fw install' inside a project."
}

cmd_install() {
  local mode=auto dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --shared)   mode=shared ;;
      --personal) mode=personal ;;
      --dry-run)  dry=1 ;;
      *) bad "unknown flag: $1"; exit 2 ;;
    esac
    shift
  done

  head1 "Project: $(pwd)"

  if [ ! -f package.json ]; then
    bad "no package.json here"
    note "scaffold first, then install — the framework describes how to build, not how to create a repo"
    note "  bun create next-app@latest <name>"
    note "  bunx @angular/cli@22 new <name>"
    exit 1
  fi

  local stacks; mapfile -t stacks < <(detect_stacks)
  if [ "${#stacks[@]}" -eq 0 ] || [ -z "${stacks[0]}" ]; then
    warn "no known stack detected in package.json"
    note "expected one of: next, react, @angular/core, @nestjs/core, astro"
  else
    for s in "${stacks[@]}"; do ok "stack detected: $s"; done
  fi

  [ "$mode" = auto ] && mode="$(detect_sharing)"
  local target_claude target_docs
  if [ "$mode" = shared ]; then
    target_claude="CLAUDE.local.md"; target_docs=".fw/docs"
    ok "repository looks shared — installing privately"
    note "$(git log --format='%ae' 2>/dev/null | sort -u | wc -l | tr -d ' ') distinct commit authors"
  else
    target_claude="CLAUDE.md"; target_docs="docs"
    ok "repository looks personal — installing normally"
  fi

  head1 "Plan"
  note "$target_claude          <- framework CLAUDE.md"
  note "$target_docs/           <- framework docs"
  note "rules and skills        <- already global, nothing copied here"

  if [ "$dry" = 1 ]; then head1 "Dry run — nothing written."; return; fi

  if [ -e "$target_claude" ] && ! grep -q 'Framework Rules' "$target_claude" 2>/dev/null; then
    head1 "Aborted"
    bad "$target_claude exists and was not written by this framework"
    note "nothing was written — a half install leaves files in someone else's repo"
    if [ "$mode" = personal ]; then
      note "that file belongs to the project, which makes this a shared repository"
      note "install privately instead:  fw install --shared"
    else
      note "merge it by hand, or move it aside and rerun"
    fi
    exit 1
  fi

  head1 "Writing"
  cp "$FW_ROOT/CLAUDE.md" "$target_claude"
  ok "$target_claude"

  mkdir -p "$target_docs"
  if [ "${stacks[*]}" = "astro" ]; then
    for doc in "$FW_ROOT"/docs/*.md; do
      case "$(basename "$doc")" in clean-architecture.md|angular.md) continue ;; esac
      cp "$doc" "$target_docs"/
    done
    ok "$target_docs/ ($(ls -1 "$target_docs"/*.md | wc -l | tr -d ' ') files)"
    note "content site: the layered architecture is not installed — it earns nothing here"
    note "planning, testing and diagnosis skills are global and still apply"
  else
    cp "$FW_ROOT"/docs/*.md "$target_docs"/
    ok "$target_docs/ ($(ls -1 "$FW_ROOT"/docs/*.md | wc -l | tr -d ' ') files)"
  fi

  cmd_doctor
}

check_drift() {
  local live="$1" tracked="$2" name; name="$(basename "$live")"

  if [ ! -f "$live" ]; then warn "$name not on this machine"; return; fi
  if [ ! -f "$tracked" ]; then warn "$name not tracked — copy it into machine/"; return; fi

  if diff -q "$live" "$tracked" >/dev/null 2>&1; then
    ok "$name matches the tracked copy"
  else
    warn "$name has drifted from machine/$(basename "$tracked")"
    note "refresh with: cp $live $tracked"
  fi
}

cmd_doctor() {
  head1 "Checking install"

  local linked=0
  for rule in "$CLAUDE_HOME"/rules/fw-*.md; do
    [ -L "$rule" ] || continue
    if [ -e "$rule" ]; then ok "rule linked: $(basename "$rule")"; linked=1
    else bad "broken symlink: $rule"; fi
  done
  [ "$linked" = 0 ] && warn "no framework rules linked — run 'fw link'"

  count_linked_skills() {
    local home="$1" n=0
    for skill in "$home"/skills/*/; do
      [ -L "${skill%/}" ] || continue
      case "$(readlink -f "${skill%/}")" in "$FW_ROOT"/*) n=$((n+1)) ;; esac
    done
    printf '%s' "$n"
  }

  local total; total=$(ls -d "$FW_ROOT"/skills/*/ 2>/dev/null | wc -l | tr -d ' ')
  local claude_n; claude_n=$(count_linked_skills "$CLAUDE_HOME")
  if [ "$claude_n" -eq "$total" ]; then ok "claude: $claude_n/$total skills linked"
  elif [ "$claude_n" = 0 ]; then warn "claude: no framework skills linked — run 'fw link'"
  else bad "claude: only $claude_n/$total skills linked — run 'fw link'"; fi

  if [ -d "$OPENCODE_HOME" ]; then
    local oc_n; oc_n=$(count_linked_skills "$OPENCODE_HOME")
    if [ "$oc_n" -eq "$total" ]; then ok "opencode: $oc_n/$total skills linked"
    elif [ "$oc_n" = 0 ]; then bad "opencode: installed but has none of the skills — run 'fw link'"
    else bad "opencode: only $oc_n/$total skills linked — run 'fw link'"; fi
  fi

  if [ -f "$GIT_IGNORE_GLOBAL" ] && grep -qxF '.fw/' "$GIT_IGNORE_GLOBAL"; then
    ok "global gitignore configured"
  else
    bad "global gitignore missing entries — run 'fw link'"
  fi

  check_drift "$HOME/.gentle-ai/state.json" "$FW_ROOT/machine/gentle-ai-state.json"
  check_drift "$HOME/.claude/settings.json" "$FW_ROOT/machine/claude-settings.json"

  if git rev-parse --git-dir >/dev/null 2>&1; then
    local leaked
    leaked=$(git status --porcelain 2>/dev/null | grep -E 'CLAUDE\.local\.md|^\?\? \.fw/|^\?\? \.atl/' || true)
    if [ -n "$leaked" ]; then
      bad "personal files are visible to git:"
      printf '%s\n' "$leaked" | sed 's/^/      /'
      note "already tracked? untrack with: git rm --cached <file>"
    else
      ok "nothing personal is visible to git"
    fi
  fi

  [ "$FW_BAD" -eq 0 ] || { head1 "$FW_BAD problem(s) found"; return 1; }
}

pkg_script() {
  [ -f package.json ] || return 1
  grep -qE "\"$1\"[[:space:]]*:" <(sed -n '/"scripts"/,/}/p' package.json)
}

runner() {
  if [ -f bun.lock ] || [ -f bun.lockb ]; then echo bun
  elif [ -f pnpm-lock.yaml ]; then echo pnpm
  else echo npm; fi
}

EV_ROWS=()
EV_FAILED=0

summarize() {
  local out="$1" rc="$2" plain line count
  plain="$(sed 's/\x1b\[[0-9;]*m//g' "$out")"

  line=$(printf '%s\n' "$plain" | grep -E '^[[:space:]]*Tests[[:space:]]+[0-9]' | tail -1 || true)
  if [ -n "$line" ]; then
    printf '%s' "$(printf '%s' "$line" \
      | sed 's/^[[:space:]]*Tests[[:space:]]*//; s/[[:space:]]*|[[:space:]]*/, /g' \
      | tr -s ' ')"
    return
  fi

  count=$(printf '%s\n' "$plain" | grep -cE 'error TS[0-9]+' || true)
  if [ "$count" -gt 0 ]; then printf '%s type error(s)' "$count"; return; fi

  count=$(printf '%s\n' "$plain" | grep -cE '^(DRIFT|UNREACHABLE)[[:space:]]' || true)
  if [ "$count" -gt 0 ]; then printf '%s contract(s) drifted' "$count"; return; fi

  if [ "$rc" -eq 0 ]; then printf 'clean'; else printf 'see output'; fi
}

run_check() {
  local label="$1" command="$2"
  local out rc
  out=$(mktemp)
  set +e
  eval "$command" >"$out" 2>&1
  rc=$?
  set -e

  local summary; summary="$(summarize "$out" "$rc")"

  if [ "$rc" -ne 0 ]; then EV_FAILED=1; fi
  EV_ROWS+=("| $label | \`$command\` | $rc | $summary |")

  if [ "$rc" -eq 0 ]; then ok "$label — exit 0 — $summary"
  else
    bad "$label — exit $rc"
    sed 's/^/      /' "$out" | tail -12
  fi
  rm -f "$out"
}

cmd_evidence() {
  local rt; rt="$(runner)"
  head1 "Collecting evidence in $(pwd)"

  if [ ! -f package.json ]; then bad "no package.json here"; exit 1; fi

  if pkg_script typecheck; then run_check "typecheck" "$rt run typecheck"
  elif [ -f tsconfig.json ]; then run_check "typecheck" "${rt}x tsc --noEmit"
  else warn "no typecheck available"; fi

  if pkg_script test; then run_check "tests" "$rt run test"
  else warn "no test script in package.json"; fi

  for path in .fw/contracts/verify.ts contracts/verify.ts; do
    [ -f "$path" ] || continue
    run_check "contracts" "$rt run $path"
    break
  done

  local verdict; verdict=$([ "$EV_FAILED" -eq 0 ] && echo PASS || echo FAIL)

  head1 "Paste this into the verification report"
  printf '\n## Verification Evidence\n\n'
  printf 'Collected: %s\n' "$(date -Iseconds)"
  printf 'Commit: %s\n\n' "$(git rev-parse --short HEAD 2>/dev/null || echo 'not a git repository')"
  printf '| Check | Command | Exit | Result |\n|---|---|---|---|\n'
  if [ "${#EV_ROWS[@]}" -gt 0 ]; then printf '%s\n' "${EV_ROWS[@]}"; fi
  printf '\n**Verdict: %s**\n\n' "$verdict"

  [ "$EV_FAILED" -eq 0 ] || exit 1
}

BACKLOG_FILE="${FW_BACKLOG:-$HOME/backlog.md}"
STALE_DAYS="${FW_STALE_DAYS:-3}"

cmd_backlog() {
  if [ "${1:-}" = "--init" ]; then
    if [ -f "$BACKLOG_FILE" ]; then
      bad "$BACKLOG_FILE already exists — left untouched"
      exit 1
    fi
    cat > "$BACKLOG_FILE" <<'SKELETON'
# Backlog

## Ready

## Blocked

## Not ready
SKELETON
    head1 "Created $BACKLOG_FILE"
    note "Ready     — passes the Definition of Ready, can be finished without asking anyone"
    note "Blocked   — waiting on an answer. Record the question and (asked YYYY-MM-DD)"
    note "Not ready — no criteria yet. Run the requirements skill on it first"
    return
  fi

  if [ ! -f "$BACKLOG_FILE" ]; then
    head1 "No backlog at $BACKLOG_FILE"
    note "create it with:  fw backlog --init"
    note "see skills/backlog/SKILL.md for what belongs in each section"
    exit 1
  fi

  local section="" ready=0 blocked=0 notready=0 stale=0
  local today; today=$(date +%s)

  head1 "Ready to start"
  while IFS= read -r line; do
    case "$line" in
      '## Ready'*)     section=ready;     continue ;;
      '## Blocked'*)   section=blocked;   continue ;;
      '## Not ready'*) section=notready;  continue ;;
      '#'*)            section="";        continue ;;
    esac
    case "$line" in "- "*) ;; *) continue ;; esac

    local text="${line#- }"
    case "$section" in
      ready)    ok "$text"; ready=$((ready+1)) ;;
      notready) notready=$((notready+1)) ;;
      blocked)
        blocked=$((blocked+1))
        local asked days
        asked=$(printf '%s' "$text" | grep -oE 'asked [0-9]{4}-[0-9]{2}-[0-9]{2}' | tail -1 | cut -d' ' -f2 || true)
        if [ -n "$asked" ]; then
          days=$(( (today - $(date -d "$asked" +%s 2>/dev/null || echo "$today")) / 86400 ))
        else
          days=""
        fi
        BLOCKED_LINES+=("$days|$text")
        if [ -n "$days" ] && [ "$days" -ge "$STALE_DAYS" ]; then stale=$((stale+1)); fi
        ;;
    esac
  done < "$BACKLOG_FILE"

  if [ $((ready + blocked + notready)) -eq 0 ]; then
    note "the backlog is empty"
  elif [ "$ready" -eq 0 ]; then
    warn "nothing is ready — every item is blocked or missing criteria"
  fi

  head1 "Blocked, longest wait first"
  if [ "${#BLOCKED_LINES[@]}" -eq 0 ]; then
    note "nothing blocked"
  else
    printf '%s\n' "${BLOCKED_LINES[@]}" | sort -t'|' -k1,1nr | while IFS='|' read -r days text; do
      if [ -z "$days" ]; then
        warn "no date — $text"
      elif [ "$days" -ge "$STALE_DAYS" ]; then
        bad "${days}d — $text"
      else
        note "${days}d — $text"
      fi
    done
  fi

  head1 "Summary"
  note "ready $ready · blocked $blocked · not ready $notready"
  if [ "$stale" -gt 0 ]; then
    bad "$stale question(s) unanswered for $STALE_DAYS+ days — follow up on the oldest first"
  fi
  if [ "$notready" -gt 0 ]; then
    note "$notready item(s) need criteria before they can be judged — see skills/requirements/"
  fi
}

BLOCKED_LINES=()

case "${1:-}" in
  backlog)  shift; cmd_backlog "$@" ;;
  link)     shift; cmd_link "$@" ;;
  install)  shift; cmd_install "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  evidence) shift; cmd_evidence "$@" ;;
  *)
    cat <<EOF
fw — install this framework into a project

  fw link              once per machine: symlink rules and skills, set global gitignore
  fw install           in a project: detect stack, install CLAUDE.md and docs
    --shared           force private install (CLAUDE.local.md + .fw/docs)
    --personal         force normal install
    --dry-run          show the plan, write nothing
  fw doctor            verify the install and that nothing personal leaks into git
  fw evidence          run typecheck, tests and contracts; print a pasteable
                       evidence table. Exits non-zero if any check fails
  fw backlog           what is ready to start, and how long each blocked item
                       has been waiting on an answer
                       FW_BACKLOG=<file>   default ~/backlog.md
                       FW_STALE_DAYS=<n>   default 3

Framework root: $FW_ROOT
EOF
    ;;
esac
